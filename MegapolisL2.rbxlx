  </Item>
  <Item class="StarterPlayer" referent="20">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="21">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = Shared:WaitForChild("configs")

local ClassesConfig = require(Configs:WaitForChild("ClassesConfig"))
local SkillsConfig = require(Configs:WaitForChild("SkillsConfig"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local TargetController = require(script.Parent:WaitForChild("TargetController"))

local ATTACK_INTERVAL = 0.50
local LMB_HOLD_ATTACK_RANGE = 18
local KEY_ATTACK_RANGE = 18
local AUTO_SKILL_TARGET_RANGE = 30

local localPlayer = Players.LocalPlayer

local CombatController = {}

local comboIndex = 1
local lastAttackSent = 0
local isHoldingLMB = false
local isHoldingAttackKey = false
local initialized = false
local swingSequenceToken = 0

local skillReadyTimestamps: { [string]: number } = {}
local slashAnimTrack: AnimationTrack? = nil
local cachedHumanoid: Humanoid? = nil
local cachedRightShoulderC0: { [Motor6D]: CFrame } = {}
local cachedTorsoJointC0: { [Motor6D]: CFrame } = {}

local function getMobRootPart(mobModel: Model): BasePart?
	if mobModel.PrimaryPart then
		return mobModel.PrimaryPart
	end
	local hrp = mobModel:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	local torso = mobModel:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	return mobModel:FindFirstChildWhichIsA("BasePart")
end

local function findNearestMobOnClient(origin: Vector3, maxRange: number, deadSpoiledOnly: boolean): Model?
	local activeMobsFolder = Workspace:FindFirstChild("ActiveMobs")
	if not activeMobsFolder then
		return nil
	end

	local bestMob: Model? = nil
	local bestDist = maxRange

	for _, child in ipairs(activeMobsFolder:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute("IsMob") == true then
			local hp = (child:GetAttribute("CurrentHP") :: number?) or 0
			local isValid = false
			if deadSpoiledOnly then
				local isSpoiled = child:GetAttribute("IsSpoiled") == true
				local canSweep = child:GetAttribute("CanSweep") == true
				isValid = (hp <= 0) and (isSpoiled or canSweep)
			else
				isValid = (hp > 0)
			end

			if isValid then
				local root = getMobRootPart(child)
				if root then
					local dist = (root.Position - origin).Magnitude
					if dist <= bestDist then
						bestDist = dist
						bestMob = child
					end
				end
			end
		end
	end

	return bestMob
end

local function activateWeaponTrail(character: Model)
	local weaponModel = character:FindFirstChild("EquippedClassWeapon")
	if not weaponModel then
		return
	end
	local trail = weaponModel:FindFirstChild("WeaponTrail") :: Trail?
	if trail then
		trail.Enabled = true
		task.delay(0.24, function()
			if trail.Parent then
				trail.Enabled = false
			end
		end)
	end
end

local function playStandardSlashAnimation(humanoid: Humanoid)
	if cachedHumanoid ~= humanoid then
		cachedHumanoid = humanoid
		slashAnimTrack = nil
	end

	if not slashAnimTrack then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://522635514"
		local ok, track = pcall(function()
			return (animator :: Animator):LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			slashAnimTrack = track
		end
	end

	if slashAnimTrack then
		pcall(function()
			slashAnimTrack:Play(0.05, 1, 1.35)
		end)
	end
end

function CombatController.PlayComboSwingVisual(comboStep: number)
	task.spawn(function()
		pcall(function()
			local character = localPlayer.Character
			if not character then
				return
			end

			activateWeaponTrail(character)

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				playStandardSlashAnimation(humanoid)
			end

			local rightShoulder = character:FindFirstChild("Right Shoulder", true) :: Motor6D?
				or character:FindFirstChild("RightShoulder", true) :: Motor6D?
			local torsoJoint = character:FindFirstChild("RootJoint", true) :: Motor6D?
				or character:FindFirstChild("Waist", true) :: Motor6D?

			if not rightShoulder and not torsoJoint then
				return
			end

			local baseShoulderC0: CFrame? = nil
			if rightShoulder then
				baseShoulderC0 = cachedRightShoulderC0[rightShoulder]
				if not baseShoulderC0 then
					baseShoulderC0 = rightShoulder.C0
					cachedRightShoulderC0[rightShoulder] = baseShoulderC0
				end
			end

			local baseTorsoC0: CFrame? = nil
			if torsoJoint then
				baseTorsoC0 = cachedTorsoJointC0[torsoJoint]
				if not baseTorsoC0 then
					baseTorsoC0 = torsoJoint.C0
					cachedTorsoJointC0[torsoJoint] = baseTorsoC0
				end
			end

			local swingAngles: CFrame
			if comboStep == 1 then
				swingAngles = CFrame.Angles(math.rad(85), math.rad(-25), math.rad(25))
			elseif comboStep == 2 then
				swingAngles = CFrame.Angles(math.rad(95), math.rad(30), math.rad(-30))
			else
				swingAngles = CFrame.Angles(math.rad(125), 0, math.rad(10))
			end

			local yaw = if comboStep == 1 then math.rad(18) elseif comboStep == 2 then math.rad(-18) else math.rad(24)
			local torsoAngles = CFrame.Angles(0, yaw, 0)

			swingSequenceToken += 1
			local myToken = swingSequenceToken

			-- Phase 1: Forward strike (0.10s) using RenderStepped CFrame:Lerp
			local strikeDuration = 0.10
			local t0 = os.clock()
			while true do
				if swingSequenceToken ~= myToken then
					return
				end
				local alpha = math.clamp((os.clock() - t0) / strikeDuration, 0, 1)
				if rightShoulder and rightShoulder.Parent and baseShoulderC0 then
					rightShoulder.C0 = baseShoulderC0:Lerp(baseShoulderC0 * swingAngles, alpha)
				end
				if torsoJoint and torsoJoint.Parent and baseTorsoC0 then
					torsoJoint.C0 = baseTorsoC0:Lerp(baseTorsoC0 * torsoAngles, alpha)
				end
				if alpha >= 1 then
					break
				end
				RunService.RenderStepped:Wait()
			end

			-- Phase 2: Smooth recovery back to baseC0 (0.14s)
			local recoverDuration = 0.14
			local t1 = os.clock()
			while true do
				if swingSequenceToken ~= myToken then
					return
				end
				local alpha = math.clamp((os.clock() - t1) / recoverDuration, 0, 1)
				if rightShoulder and rightShoulder.Parent and baseShoulderC0 then
					rightShoulder.C0 = (baseShoulderC0 * swingAngles):Lerp(baseShoulderC0, alpha)
				end
				if torsoJoint and torsoJoint.Parent and baseTorsoC0 then
					torsoJoint.C0 = (baseTorsoC0 * torsoAngles):Lerp(baseTorsoC0, alpha)
				end
				if alpha >= 1 then
					break
				end
				RunService.RenderStepped:Wait()
			end
		end)
	end)
end

function CombatController.GetSkillForSlot(slot: string): SkillsConfig.SkillData?
	local classId = (localPlayer:GetAttribute("ClassId") :: string?) or "RiotPolice"
	local classData = ClassesConfig[classId] or ClassesConfig.RiotPolice
	local skillId = classData.skillSlots[slot]
	if not skillId then
		return nil
	end
	return SkillsConfig[skillId]
end

function CombatController.GetSlotCooldownRemaining(slot: string): (number, number)
	if slot == "1" then
		local rem = math.max(0, (lastAttackSent + ATTACK_INTERVAL) - os.clock())
		return rem, ATTACK_INTERVAL
	end
	local skillData = CombatController.GetSkillForSlot(slot)
	if not skillData then
		return 0, 1
	end
	local readyAt = skillReadyTimestamps[skillData.id] or 0
	local remaining = math.max(0, readyAt - os.clock())
	return remaining, skillData.cooldown
end

function CombatController.ResetSkillCooldown(skillId: string)
	skillReadyTimestamps[skillId] = 0
end

function CombatController.UseSkillSlot(slotKey: "Q" | "E" | "R" | "F")
	local skillData = CombatController.GetSkillForSlot(slotKey)
	local now = os.clock()
	if skillData then
		local readyAt = skillReadyTimestamps[skillData.id] or 0
		if now < readyAt then
			return
		end
	end

	local character = localPlayer.Character
	local playerRoot = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local targetModel = TargetController.GetTarget()

	if playerRoot and skillData then
		if skillData.targetType == "DeadSpoiledTarget" then
			local hp = if targetModel then ((targetModel:GetAttribute("CurrentHP") :: number?) or 0) else 1
			local isSpoiled = if targetModel
				then (targetModel:GetAttribute("IsSpoiled") == true or targetModel:GetAttribute("CanSweep") == true)
				else false
			if not targetModel or hp > 0 or not isSpoiled then
				local corpse = findNearestMobOnClient(playerRoot.Position, AUTO_SKILL_TARGET_RANGE, true)
				if corpse then
					TargetController.SetTarget(corpse)
					targetModel = corpse
				end
			end
		elseif skillData.targetType == "SingleTarget" or skillData.targetType == "FrontalCone" then
			local hp = if targetModel then ((targetModel:GetAttribute("CurrentHP") :: number?) or 0) else 0
			if not targetModel or hp <= 0 then
				local nearestAlive = findNearestMobOnClient(playerRoot.Position, AUTO_SKILL_TARGET_RANGE, false)
				if nearestAlive then
					TargetController.SetTarget(nearestAlive)
					targetModel = nearestAlive
				end
			end
		end
	end

	if skillData then
		skillReadyTimestamps[skillData.id] = now + skillData.cooldown
	end

	-- 1. ALWAYS fire the remote to the server FIRST before playing any visual animation
	Remotes.UseSkill:FireServer(slotKey, TargetController.GetTarget())

	-- 2. Play visual swing animation safely
	CombatController.PlayComboSwingVisual(comboIndex)
	comboIndex = (comboIndex % 3) + 1
end

local function tryPerformAttack(maxRange: number)
	local now = os.clock()
	if (now - lastAttackSent) < ATTACK_INTERVAL then
		return
	end

	local character = localPlayer.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local playerRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not playerRoot or humanoid.Health <= 0 then
		return
	end

	local target = TargetController.GetTarget()
	local hp = if target then ((target:GetAttribute("CurrentHP") :: number?) or 0) else 0
	if not target or hp <= 0 then
		local autoMob = findNearestMobOnClient(playerRoot.Position, maxRange, false)
		if autoMob then
			TargetController.SetTarget(autoMob)
			target = autoMob
			hp = (autoMob:GetAttribute("CurrentHP") :: number?) or 0
		end
	end

	if not target or hp <= 0 then
		return
	end

	local targetRoot = getMobRootPart(target)
	if not targetRoot then
		return
	end

	local distance = (targetRoot.Position - playerRoot.Position).Magnitude
	if distance > maxRange then
		return
	end

	lastAttackSent = now

	-- 1. ALWAYS fire the remote to the server FIRST
	Remotes.RequestAttack:FireServer(target)

	-- 2. Play visual swing animation safely
	CombatController.PlayComboSwingVisual(comboIndex)
	comboIndex = (comboIndex % 3) + 1
end

function CombatController.RequestBasicAttack()
	tryPerformAttack(KEY_ATTACK_RANGE)
end

function CombatController.Init()
	if initialized then
		return
	end
	initialized = true

	Remotes.SkillVFX.OnClientEvent:Connect(function(skillId: string, casterPlayer: Player, payload: { [string]: any }?)
		if casterPlayer == localPlayer and skillId == "NO_TARGET" then
			local data = payload or {}
			local failedSkillId = data.skillId :: string?
			if failedSkillId then
				skillReadyTimestamps[failedSkillId] = 0
			end
		end
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isHoldingLMB = true
			tryPerformAttack(LMB_HOLD_ATTACK_RANGE)
		elseif input.KeyCode == Enum.KeyCode.One then
			isHoldingAttackKey = true
			tryPerformAttack(KEY_ATTACK_RANGE)
		elseif input.KeyCode == Enum.KeyCode.Q then
			CombatController.UseSkillSlot("Q")
		elseif input.KeyCode == Enum.KeyCode.E then
			CombatController.UseSkillSlot("E")
		elseif input.KeyCode == Enum.KeyCode.R then
			CombatController.UseSkillSlot("R")
		elseif input.KeyCode == Enum.KeyCode.F then
			CombatController.UseSkillSlot("F")
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isHoldingLMB = false
		elseif input.KeyCode == Enum.KeyCode.One then
			isHoldingAttackKey = false
		end
	end)

	RunService.Heartbeat:Connect(function()
		if isHoldingLMB then
			tryPerformAttack(LMB_HOLD_ATTACK_RANGE)
		elseif isHoldingAttackKey then
			tryPerformAttack(KEY_ATTACK_RANGE)
		end
	end)
end

return CombatController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="24">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict

local LocalizationService = game:GetService("LocalizationService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = Shared:WaitForChild("configs")
local I18nFolder = Shared:WaitForChild("i18n")

local I18n = require(I18nFolder:WaitForChild("I18n"))
local MobsConfig = require(Configs:WaitForChild("MobsConfig"))

local VFXController = require(script.Parent:WaitForChild("VFXController"))
local TargetController = require(script.Parent:WaitForChild("TargetController"))
local CombatController = require(script.Parent:WaitForChild("CombatController"))
local UIController = require(script.Parent:WaitForChild("UIController"))

local sysOk, sysLocale = pcall(function(): string
	return LocalizationService.SystemLocaleId
end)
local rbxOk, rbxLocale = pcall(function(): string
	return LocalizationService.RobloxLocaleId
end)

local systemLocaleId = if sysOk and type(sysLocale) == "string" then sysLocale else "unknown"
local robloxLocaleId = if rbxOk and type(rbxLocale) == "string" then rbxLocale else "unknown"

print("=== [MegapolisL2 Client Initialization] ===")
print(string.format("SystemLocaleId: %s | RobloxLocaleId: %s", systemLocaleId, robloxLocaleId))

local detectedLang = I18n.GetLanguage()
print(I18n.t("UI_WELCOME", { lang = string.upper(detectedLang) }))

local sortedMobs: { MobsConfig.MobData } = {}
for _, mobData in pairs(MobsConfig) do
	table.insert(sortedMobs, mobData)
end
table.sort(sortedMobs, function(a: MobsConfig.MobData, b: MobsConfig.MobData): boolean
	return a.level < b.level
end)

print(string.format("--- Tier 1 Mobs (%s) ---", string.upper(detectedLang)))
for _, mob in ipairs(sortedMobs) do
	local localizedName = I18n.t(mob.nameKey)
	local localizedLevel = I18n.t("UI_LEVEL", { lv = mob.level })
	local localizedLocation = I18n.t(mob.locationId)
	local bossTag = if mob.isRaidBoss then " [RAID BOSS]" else ""

	print(string.format("%s (%s)%s - %s", localizedName, localizedLevel, bossTag, localizedLocation))
end

-- Initialize Phase 1 & Phase 2 Client Controllers
VFXController.Init()
TargetController.Init()
CombatController.Init()
UIController.Init()

print("=== [MegapolisL2 Client Phase 0, Phase 1 & Phase 2 Initialized] ===")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">TargetController</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local TAB_TARGET_RANGE = 60
local RAYCAST_DISTANCE = 250

local localPlayer = Players.LocalPlayer

local TargetController = {}

local onTargetChangedEvent = Instance.new("BindableEvent")
onTargetChangedEvent.Name = "OnTargetChanged"
TargetController.OnTargetChanged = onTargetChangedEvent

local currentTarget: Model? = nil
local targetRingPart: Part? = nil
local targetHpConn: RBXScriptConnection? = nil
local targetSweepConn: RBXScriptConnection? = nil
local targetAncestryConn: RBXScriptConnection? = nil
local lastCycleIndex = 0
local initialized = false

local function getMobRootPart(mobModel: Model): BasePart?
	if mobModel.PrimaryPart then
		return mobModel.PrimaryPart
	end
	local hrp = mobModel:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	local torso = mobModel:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	return mobModel:FindFirstChildWhichIsA("BasePart")
end

local function ensureSelectionRing(): Part
	if targetRingPart and targetRingPart.Parent then
		return targetRingPart
	end

	local ring = Instance.new("Part")
	ring.Name = "L2TargetSelectionRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(0, 235, 255)
	ring.Transparency = 0.25
	ring.Size = Vector3.new(0.14, 4.6, 4.6)
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Parent = Workspace

	local adornment = Instance.new("CylinderHandleAdornment")
	adornment.Name = "CyanRingGlow"
	adornment.Adornee = ring
	adornment.CFrame = CFrame.Angles(0, math.rad(90), 0)
	adornment.InnerRadius = 1.95
	adornment.Radius = 2.35
	adornment.Height = 0.16
	adornment.Color3 = Color3.fromRGB(0, 245, 255)
	adornment.Transparency = 0.1
	adornment.AlwaysOnTop = false
	adornment.Parent = ring

	targetRingPart = ring
	return ring
end

local function hideSelectionRing()
	if targetRingPart then
		targetRingPart.Parent = nil
	end
end

local function isMobSelectable(mobModel: Model?): boolean
	if not mobModel or not mobModel.Parent then
		return false
	end
	if mobModel:GetAttribute("IsMob") ~= true then
		return false
	end
	local hp = (mobModel:GetAttribute("CurrentHP") :: number?) or 0
	if hp > 0 then
		return true
	end
	if mobModel:GetAttribute("CanSweep") == true or mobModel:GetAttribute("IsSpoiled") == true then
		return true
	end
	return false
end

local function disconnectTargetConnections()
	if targetHpConn then
		targetHpConn:Disconnect()
		targetHpConn = nil
	end
	if targetSweepConn then
		targetSweepConn:Disconnect()
		targetSweepConn = nil
	end
	if targetAncestryConn then
		targetAncestryConn:Disconnect()
		targetAncestryConn = nil
	end
end

function TargetController.SetTarget(newTarget: Model?)
	if newTarget and not isMobSelectable(newTarget) then
		newTarget = nil
	end

	if currentTarget == newTarget then
		return
	end

	disconnectTargetConnections()
	currentTarget = newTarget

	if currentTarget then
		local activeTarget = currentTarget
		targetHpConn = activeTarget:GetAttributeChangedSignal("CurrentHP"):Connect(function()
			local hp = (activeTarget:GetAttribute("CurrentHP") :: number?) or 0
			local isSpoiled = activeTarget:GetAttribute("IsSpoiled") == true
			local canSweep = activeTarget:GetAttribute("CanSweep") == true
			if hp <= 0 and not isSpoiled and not canSweep and currentTarget == activeTarget then
				TargetController.SetTarget(nil)
			end
		end)
		targetSweepConn = activeTarget:GetAttributeChangedSignal("CanSweep"):Connect(function()
			local hp = (activeTarget:GetAttribute("CurrentHP") :: number?) or 0
			local canSweep = activeTarget:GetAttribute("CanSweep") == true
			local isSpoiled = activeTarget:GetAttribute("IsSpoiled") == true
			if hp <= 0 and not canSweep and not isSpoiled and currentTarget == activeTarget then
				TargetController.SetTarget(nil)
			end
		end)
		targetAncestryConn = activeTarget.AncestryChanged:Connect(function(_, parent: Instance?)
			if not parent and currentTarget == activeTarget then
				TargetController.SetTarget(nil)
			end
		end)
	else
		hideSelectionRing()
	end

	Remotes.SelectTarget:FireServer(currentTarget)
	onTargetChangedEvent:Fire(currentTarget)
end

function TargetController.GetTarget(): Model?
	if currentTarget and not isMobSelectable(currentTarget) then
		TargetController.SetTarget(nil)
	end
	return currentTarget
end

local function findMobModelFromInstance(hitInstance: Instance?): Model?
	local activeMobsFolder = Workspace:FindFirstChild("ActiveMobs")
	if not activeMobsFolder or not hitInstance then
		return nil
	end

	local current: Instance? = hitInstance
	while current and current ~= Workspace do
		if current:IsA("Model") and current.Parent == activeMobsFolder and current:GetAttribute("IsMob") == true then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function tryMouseTargetSelect()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	local mousePos = UserInputService:GetMouseLocation()
	local unitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList: { Instance } = {}
	if localPlayer.Character then
		table.insert(ignoreList, localPlayer.Character)
	end
	if targetRingPart then
		table.insert(ignoreList, targetRingPart)
	end
	rayParams.FilterDescendantsInstances = ignoreList

	local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * RAYCAST_DISTANCE, rayParams)
	if result and result.Instance then
		local mobModel = findMobModelFromInstance(result.Instance)
		if mobModel and isMobSelectable(mobModel) then
			TargetController.SetTarget(mobModel)
		end
	end
end

local function cycleTabTarget()
	local character = localPlayer.Character
	local playerRoot = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	if not playerRoot then
		return
	end

	local activeMobsFolder = Workspace:FindFirstChild("ActiveMobs")
	if not activeMobsFolder then
		return
	end

	type Candidate = {
		model: Model,
		distance: number,
	}

	local candidates: { Candidate } = {}
	for _, child in ipairs(activeMobsFolder:GetChildren()) do
		if child:IsA("Model") and isMobSelectable(child) then
			local mobRoot = getMobRootPart(child)
			if mobRoot then
				local dist = (mobRoot.Position - playerRoot.Position).Magnitude
				if dist <= TAB_TARGET_RANGE then
					table.insert(candidates, { model = child, distance = dist })
				end
			end
		end
	end

	if #candidates == 0 then
		return
	end

	table.sort(candidates, function(a: Candidate, b: Candidate): boolean
		return a.distance < b.distance
	end)

	lastCycleIndex = (lastCycleIndex % #candidates) + 1
	local chosen = candidates[lastCycleIndex].model
	if chosen == currentTarget and #candidates > 1 then
		lastCycleIndex = (lastCycleIndex % #candidates) + 1
		chosen = candidates[lastCycleIndex].model
	end

	TargetController.SetTarget(chosen)
end

function TargetController.Init()
	if initialized then
		return
	end
	initialized = true

	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			tryMouseTargetSelect()
		elseif input.KeyCode == Enum.KeyCode.Tab then
			cycleTabTarget()
		elseif input.KeyCode == Enum.KeyCode.Escape then
			TargetController.SetTarget(nil)
		end
	end)

	RunService.RenderStepped:Connect(function()
		local target = currentTarget
		if not target or not isMobSelectable(target) then
			hideSelectionRing()
			return
		end

		local root = getMobRootPart(target)
		if not root then
			hideSelectionRing()
			return
		end

		local ring = ensureSelectionRing()
		if ring.Parent ~= Workspace then
			ring.Parent = Workspace
		end

		local footOffset = root.Size.Y * 1.5 - 0.08
		local ringPos = root.Position - Vector3.new(0, footOffset, 0)
		ring.CFrame = CFrame.new(ringPos) * CFrame.Angles(0, 0, math.rad(90))
	end)
end

return TargetController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = Shared:WaitForChild("configs")
local I18nFolder = Shared:WaitForChild("i18n")

local GameConstants = require(Configs:WaitForChild("GameConstants"))
local ClassesConfig = require(Configs:WaitForChild("ClassesConfig"))
local RacesConfig = require(Configs:WaitForChild("RacesConfig"))
local SkillsConfig = require(Configs:WaitForChild("SkillsConfig"))
local I18n = require(I18nFolder:WaitForChild("I18n"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local TargetController = require(script.Parent:WaitForChild("TargetController"))
local CombatController = require(script.Parent:WaitForChild("CombatController"))

local localPlayer = Players.LocalPlayer

local UIController = {}

local L2_BG_COLOR = Color3.fromRGB(16, 19, 27)
local L2_PANEL_COLOR = Color3.fromRGB(22, 26, 36)
local L2_GOLD_BORDER = Color3.fromRGB(175, 145, 85)
local L2_SUB_BORDER = Color3.fromRGB(95, 82, 55)

local RADAR_WORLD_RADIUS = 85

local playerState = {
	level = 1,
	exp = 0,
	maxExp = GameConstants.GetRequiredExp(1),
	cash = 0,
	hp = 180,
	maxHp = 180,
	mp = 100,
	maxMp = 100,
	raceId = "RACE_LAW",
	classId = "RiotPolice",
	trashTokens = 0,
	initialized = false,
}

type SavedClassProgressClient = {
	Level: number,
	Exp: number,
	HP: number,
	MP: number,
}

type ClientProfileData = {
	IsCharacterCreated: boolean,
	RaceId: string,
	CurrentClassId: string,
	UnlockedClasses: { [string]: boolean },
	ClassProgress: { [string]: SavedClassProgressClient },
	BossKills: {
		PlatformBaron: number,
		BlackFridayGolem: number,
		NightclubKing: number,
		InflationArchitect: number,
	},
	Cash: number,
	TrashTokens: number,
}

local clientProfile: ClientProfileData = {
	IsCharacterCreated = false,
	RaceId = "RACE_LAW",
	CurrentClassId = "RiotPolice",
	UnlockedClasses = {},
	ClassProgress = {},
	BossKills = {
		PlatformBaron = 0,
		BlackFridayGolem = 0,
		NightclubKing = 0,
		InflationArchitect = 0,
	},
	Cash = 0,
	TrashTokens = 0,
}

local selectedCreationRace: RacesConfig.RaceId = "RACE_LAW"
local selectedCreationClass: string = "RiotPolice"

type HotbarSlotKey = "1" | "Q" | "E" | "R" | "F"

type HotbarSlotUI = {
	slot: HotbarSlotKey,
	button: TextButton,
	nameLabel: TextLabel,
	mpLabel: TextLabel,
	cooldownOverlay: Frame,
	cooldownText: TextLabel,
}

local HOTBAR_SLOT_KEYS: { HotbarSlotKey } = { "1", "Q", "E", "R", "F" }
local PLAYABLE_CLASS_IDS = { "RiotPolice", "HellsSousChef", "RecycleHunter" }
local RACE_IDS: { RacesConfig.RaceId } = {
	"RACE_LAW",
	"RACE_STREET",
	"RACE_CORP",
	"RACE_WORKER",
	"RACE_NIGHT",
}

local CLASS_SKILL_SLOTS_ORDER = { "Q", "E", "R", "F" }

-- 2. Top-Left Player Status Frame Elements
local hudLevelBadge: TextLabel
local hudPlayerNameLabel: TextLabel
local hudClassRaceSubtitle: TextLabel
local hudHpFill: Frame
local hudHpText: TextLabel
local hudMpFill: Frame
local hudMpText: TextLabel
local hudExpFill: Frame
local hudExpText: TextLabel

-- 3. Top-Center Target Status Frame Elements
local targetFrame: Frame
local targetNameLabel: TextLabel
local targetStatusTag: TextLabel
local targetHpFill: Frame
local targetHpValueLabel: TextLabel
local targetMpFill: Frame
local targetMpValueLabel: TextLabel

-- 4. Top-Right Minimap / Radar Elements
local minimapLocationLabel: TextLabel
local minimapCanvas: Frame
local minimapCoordsLabel: TextLabel
local radarDotsByMob: { [Model]: Frame } = {}

-- 5. Bottom-Left Lineage 2 Chat & System Combat Log Elements
local chatScrollFrame: ScrollingFrame
local chatListLayout: UIListLayout
local chatInputBox: TextBox
local chatLogCount = 0

-- 6. Bottom-Center Skill Hotbar
local hotbarSlots: { HotbarSlotUI } = {}

-- 7. Bottom-Right Menu Buttons & Modals
local btnInventory: TextButton
local btnJob: TextButton
local btnStats: TextButton
local btnLang: TextButton

local inventoryModal: Frame
local inventoryTitleLabel: TextLabel
local inventoryCloseBtn: TextButton
local inventoryContentLabel: TextLabel

local statsModal: Frame
local statsTitleLabel: TextLabel
local statsCloseBtn: TextLabel | TextButton
local statsContentLabel: TextLabel

-- [J] Job & Subclass Dossier Modal Elements
local jobModalFrame: Frame
local jobModalTitle: TextLabel
local jobCloseBtn: TextButton
local jobLockedRaceBanner: TextLabel
local jobDossierHeaderLabel: TextLabel
local jobDossierHintLabel: TextLabel
local jobLevelChecklistLabel: TextLabel
local jobBossChecklistLabels: { [string]: TextLabel } = {}
local classButtons: { [string]: TextButton } = {}

-- First-Time Character Creation Full-Screen Modal Elements
local charCreationScreen: Frame
local charCreateTitleLabel: TextLabel
local charCreateSubtitleLabel: TextLabel
local charCreateLangBtn: TextButton
local charRaceHeaderLabel: TextLabel
local charClassHeaderLabel: TextLabel
local charRacePassiveHeaderLabel: TextLabel
local charRacePassiveValueLabel: TextLabel
local charClassSkillsHeaderLabel: TextLabel
local charClassSkillsValueLabel: TextLabel
local charCreateConfirmBtn: TextButton
local creationRaceButtons: { [string]: TextButton } = {}
local creationClassButtons: { [string]: TextButton } = {}

local targetHpSignalConn: RBXScriptConnection? = nil
local targetSpoilSignalConn: RBXScriptConnection? = nil
local targetStunSignalConn: RBXScriptConnection? = nil
local initialized = false

local function disableDefaultRobloxChat()
	task.spawn(function()
		for _ = 1, 10 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
			end)
			if ok then
				break
			end
			task.wait(0.25)
		end
	end)
end

local function styleL2Frame(frame: GuiObject, cornerRadius: number, borderColor: Color3, borderThickness: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, cornerRadius)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = borderColor
	stroke.Thickness = borderThickness
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame
end

local function getMaxReachedLevelFromProfile(): number
	local maxLv = playerState.level
	for _, entry in pairs(clientProfile.ClassProgress) do
		if entry.Level > maxLv then
			maxLv = entry.Level
		end
	end
	return maxLv
end

local function getBossKillsForId(bossId: string): number
	local killsMap = clientProfile.BossKills :: any
	return (killsMap[bossId] :: number?) or 0
end

local function areAllSubclassConditionsMet(): boolean
	if getMaxReachedLevelFromProfile() < GameConstants.SUBCLASS_REQUIRED_LEVEL then
		return false
	end
	for _, bossReq in ipairs(GameConstants.SUBCLASS_REQUIRED_BOSSES) do
		if getBossKillsForId(bossReq.id) < bossReq.requiredKills then
			return false
		end
	end
	return true
end

local function formatRacePassiveText(raceId: RacesConfig.RaceId): string
	local r = RacesConfig[raceId] or RacesConfig.RACE_LAW
	return I18n.t("UI_PASSIVE_FORMAT", {
		hp = math.floor(r.hpMult * 100 + 0.5),
		atkSpd = math.floor(r.atkSpdMult * 100 + 0.5),
		crit = math.floor(r.critMult * 100 + 0.5),
		move = math.floor(r.moveSpeedMult * 100 + 0.5),
		stun = math.floor(r.stunResist * 100 + 0.5),
	})
end

local function formatClassSkillPreviewText(classId: string): string
	local cData = ClassesConfig[classId] or ClassesConfig.RiotPolice
	local headerLine = I18n.t("UI_ROLE_FORMAT", {
		role = cData.role,
		weapon = cData.weaponType,
		hp = cData.baseHpBonus,
		pdef = cData.basePDef,
	})

	local lines = { headerLine, "" }
	for _, slotKey in ipairs(CLASS_SKILL_SLOTS_ORDER) do
		local skillId = cData.skillSlots[slotKey]
		local sData = if skillId then SkillsConfig[skillId] else nil
		if sData then
			local sName = I18n.t(sData.nameKey)
			local sDesc = I18n.t(sData.descKey)
			table.insert(lines, string.format("[%s] %s — %s", slotKey, sName, sDesc))
		end
	end

	return table.concat(lines, "\n")
end

function UIController.AddSystemLog(message: string, color: Color3)
	if not chatScrollFrame then
		return
	end

	chatLogCount += 1
	local entry = Instance.new("TextLabel")
	entry.Name = "LogEntry_" .. tostring(chatLogCount)
	entry.LayoutOrder = chatLogCount
	entry.Size = UDim2.new(1, -8, 0, 0)
	entry.AutomaticSize = Enum.AutomaticSize.Y
	entry.BackgroundTransparency = 1
	entry.Font = Enum.Font.GothamMedium
	entry.TextSize = 12
	entry.TextWrapped = true
	entry.TextXAlignment = Enum.TextXAlignment.Left
	entry.TextYAlignment = Enum.TextYAlignment.Top
	entry.TextColor3 = color
	entry.TextStrokeColor3 = Color3.fromRGB(6, 8, 12)
	entry.TextStrokeTransparency = 0.25
	entry.Text = message
	entry.Parent = chatScrollFrame

	local children = chatScrollFrame:GetChildren()
	if #children > 65 then
		for _, child in ipairs(children) do
			if child:IsA("TextLabel") then
				child:Destroy()
				break
			end
		end
	end

	task.defer(function()
		if chatScrollFrame and chatListLayout then
			chatScrollFrame.CanvasSize = UDim2.fromOffset(0, chatListLayout.AbsoluteContentSize.Y + 8)
			chatScrollFrame.CanvasPosition = Vector2.new(0, math.max(0, chatListLayout.AbsoluteContentSize.Y))
		end
	end)
end

local function getTargetNameColor(mobLevel: number, playerLevel: number): Color3
	local diff = mobLevel - playerLevel
	if diff <= 2 then
		return Color3.fromRGB(220, 255, 220)
	elseif diff == 3 or diff == 4 then
		return Color3.fromRGB(255, 230, 80)
	elseif diff >= 5 and diff <= 8 then
		return Color3.fromRGB(255, 110, 180)
	else
		return Color3.fromRGB(255, 45, 45)
	end
end

local function refreshTargetFrame()
	local target = TargetController.GetTarget()
	if not target or not target.Parent then
		targetFrame.Visible = false
		return
	end

	targetFrame.Visible = true

	local nameKey = (target:GetAttribute("NameKey") :: string?) or target.Name
	local mobLevel = (target:GetAttribute("Level") :: number?) or 1
	local currentHp = math.max(0, (target:GetAttribute("CurrentHP") :: number?) or 0)
	local maxHp = math.max(1, (target:GetAttribute("MaxHP") :: number?) or 1)
	local isSpoiled = target:GetAttribute("IsSpoiled") == true or target:GetAttribute("CanSweep") == true
	local isStunned = target:GetAttribute("IsStunned") == true

	local localizedName = I18n.t(nameKey)
	local localizedLevel = I18n.t("UI_LEVEL", { lv = mobLevel })
	targetNameLabel.Text = string.format("%s  •  %s", localizedName, localizedLevel)
	targetNameLabel.TextColor3 = getTargetNameColor(mobLevel, playerState.level)

	if isStunned then
		targetStatusTag.Visible = true
		targetStatusTag.Text = "★ " .. I18n.t("UI_STUNNED")
		targetStatusTag.TextColor3 = Color3.fromRGB(255, 230, 65)
	elseif isSpoiled then
		targetStatusTag.Visible = true
		targetStatusTag.Text = "◆ " .. I18n.t("MSG_SPOIL_SUCCESS")
		targetStatusTag.TextColor3 = Color3.fromRGB(0, 235, 255)
	else
		targetStatusTag.Visible = false
	end

	local hpRatio = math.clamp(currentHp / maxHp, 0, 1)
	TweenService:Create(
		targetHpFill,
		TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(hpRatio, 1) }
	):Play()
	targetHpValueLabel.Text = string.format("%d / %d (%.0f%%)", currentHp, maxHp, hpRatio * 100)

	local maxMp = mobLevel * 40 + 60
	local currentMp = if currentHp > 0 then maxMp else 0
	local mpRatio = if maxMp > 0 then currentMp / maxMp else 0
	targetMpFill.Size = UDim2.fromScale(mpRatio, 1)
	targetMpValueLabel.Text = string.format("%s: %d / %d", I18n.t("UI_MP"), currentMp, maxMp)
end

local function refreshHotbarLabels()
	for _, slotUi in ipairs(hotbarSlots) do
		if slotUi.slot == "1" then
			slotUi.nameLabel.Text = I18n.t("UI_BASIC_ATTACK")
			slotUi.mpLabel.Text = I18n.t("UI_MP_COST", { mp = 0 })
		else
			local skillData = CombatController.GetSkillForSlot(slotUi.slot)
			if skillData then
				slotUi.nameLabel.Text = I18n.t(skillData.nameKey)
				slotUi.mpLabel.Text = I18n.t("UI_MP_COST", { mp = skillData.mpCost })
			else
				slotUi.nameLabel.Text = "-"
				slotUi.mpLabel.Text = ""
			end
		end
	end
end

local function refreshCharacterCreationScreen()
	if not charCreationScreen then
		return
	end

	charCreateTitleLabel.Text = I18n.t("UI_CHAR_CREATE_TITLE")
	charCreateSubtitleLabel.Text = I18n.t("UI_CHAR_CREATE_SUBTITLE")
	charCreateLangBtn.Text = I18n.t("UI_BTN_LANG", { lang = string.upper(I18n.GetLanguage()) })
	charRaceHeaderLabel.Text = I18n.t("UI_CHAR_SELECT_RACE")
	charClassHeaderLabel.Text = I18n.t("UI_CHAR_SELECT_CLASS")
	charRacePassiveHeaderLabel.Text = I18n.t("UI_CHAR_RACE_PASSIVES")
	charClassSkillsHeaderLabel.Text = I18n.t("UI_CHAR_CLASS_SKILLS")
	charCreateConfirmBtn.Text = I18n.t("UI_CHAR_CREATE_BTN")

	for raceId, btn in pairs(creationRaceButtons) do
		local rData = RacesConfig[raceId :: RacesConfig.RaceId]
		if rData then
			local isSelected = (selectedCreationRace == raceId)
			btn.Text = if isSelected then ("▶  " .. I18n.t(rData.nameKey)) else I18n.t(rData.nameKey)
			btn.BackgroundColor3 = if isSelected
				then Color3.fromRGB(45, 130, 90)
				else Color3.fromRGB(26, 31, 44)
		end
	end

	for classId, btn in pairs(creationClassButtons) do
		local cData = ClassesConfig[classId]
		if cData then
			local isSelected = (selectedCreationClass == classId)
			local labelText = string.format("%s (%s)", I18n.t(cData.nameKey), cData.role)
			btn.Text = if isSelected then ("▶  " .. labelText) else labelText
			btn.BackgroundColor3 = if isSelected
				then Color3.fromRGB(50, 110, 195)
				else Color3.fromRGB(26, 31, 44)
		end
	end

	charRacePassiveValueLabel.Text = formatRacePassiveText(selectedCreationRace)
	charClassSkillsValueLabel.Text = formatClassSkillPreviewText(selectedCreationClass)
end

local function refreshModals()
	jobModalTitle.Text = I18n.t("UI_CHANGE_CLASS")
	jobCloseBtn.Text = I18n.t("UI_CLOSE")

	local raceData = RacesConfig[playerState.raceId :: RacesConfig.RaceId] or RacesConfig.RACE_LAW
	jobLockedRaceBanner.Text = string.format(
		"🔒 %s  •  %s",
		I18n.t("UI_LOCKED_RACE_LABEL", { race = I18n.t(raceData.nameKey) }),
		formatRacePassiveText(raceData.id)
	)

	jobDossierHeaderLabel.Text = I18n.t("UI_SUBCLASS_DOSSIER")
	jobDossierHintLabel.Text = I18n.t("UI_SUBCLASS_HINT")

	local maxReachedLevel = getMaxReachedLevelFromProfile()
	local reqLv = GameConstants.SUBCLASS_REQUIRED_LEVEL
	local lvMet = maxReachedLevel >= reqLv
	local lvIcon = if lvMet then "[✓] " else "[✗] "
	jobLevelChecklistLabel.Text = lvIcon .. I18n.t("UI_DOSSIER_MAIN_LEVEL", {
		cur = maxReachedLevel,
		req = reqLv,
	})
	jobLevelChecklistLabel.TextColor3 = if lvMet
		then Color3.fromRGB(110, 245, 140)
		else Color3.fromRGB(255, 200, 90)

	for _, bossReq in ipairs(GameConstants.SUBCLASS_REQUIRED_BOSSES) do
		local bossLabel = jobBossChecklistLabels[bossReq.id]
		if bossLabel then
			local curKills = getBossKillsForId(bossReq.id)
			local met = curKills >= bossReq.requiredKills
			local icon = if met then "[✓] " else "[✗] "
			bossLabel.Text = icon .. I18n.t("UI_DOSSIER_BOSS_TIER", {
				tier = bossReq.tier,
				boss = I18n.t(bossReq.nameKey),
				lv = bossReq.level,
				cur = curKills,
				req = bossReq.requiredKills,
			})
			bossLabel.TextColor3 = if met
				then Color3.fromRGB(110, 245, 140)
				else Color3.fromRGB(245, 115, 115)
		end
	end

	local canUnlockNewSubclass = areAllSubclassConditionsMet()

	for classId, btn in pairs(classButtons) do
		local classData = ClassesConfig[classId]
		if classData then
			local isActive = (playerState.classId == classId)
			local isUnlocked = isActive or (clientProfile.UnlockedClasses[classId] == true)
			local savedProg = clientProfile.ClassProgress[classId]
			local classLv = if isActive
				then playerState.level
				elseif savedProg then savedProg.Level
				else 1

			local tagText = ""
			if isActive then
				tagText = I18n.t("UI_CLASS_TAG_ACTIVE", { lv = classLv })
				btn.BackgroundColor3 = Color3.fromRGB(50, 115, 195)
				btn.TextColor3 = Color3.fromRGB(255, 255, 255)
				btn.AutoButtonColor = true
			elseif isUnlocked then
				tagText = I18n.t("UI_CLASS_TAG_UNLOCKED", { lv = classLv })
				btn.BackgroundColor3 = Color3.fromRGB(36, 78, 62)
				btn.TextColor3 = Color3.fromRGB(235, 255, 240)
				btn.AutoButtonColor = true
			elseif canUnlockNewSubclass then
				tagText = I18n.t("UI_CLASS_TAG_CAN_UNLOCK")
				btn.BackgroundColor3 = Color3.fromRGB(145, 108, 32)
				btn.TextColor3 = Color3.fromRGB(255, 245, 200)
				btn.AutoButtonColor = true
			else
				tagText = I18n.t("UI_CLASS_TAG_LOCKED")
				btn.BackgroundColor3 = Color3.fromRGB(24, 22, 28)
				btn.TextColor3 = Color3.fromRGB(145, 135, 145)
				btn.AutoButtonColor = false
			end

			btn.Text = string.format("%s (%s)\n%s", I18n.t(classData.nameKey), classData.role, tagText)
		end
	end

	inventoryTitleLabel.Text = I18n.t("UI_MODAL_INVENTORY")
	inventoryCloseBtn.Text = I18n.t("UI_CLOSE")
	local classData = ClassesConfig[playerState.classId] or ClassesConfig.RiotPolice
	inventoryContentLabel.Text = string.format(
		"• %s: $%d\n• %s: %d\n\n%s\n  [1] %s (Grade NG)\n  [2] Metro Uniform Set (Grade NG)\n  [3] Standard Issue Badge",
		I18n.t("UI_CASH"),
		playerState.cash,
		I18n.t("UI_TRASH_TOKENS"),
		playerState.trashTokens,
		I18n.t("UI_EQUIPPED_GEAR"),
		classData.weaponType
	)

	statsTitleLabel.Text = I18n.t("UI_MODAL_STATS")
	if statsCloseBtn:IsA("TextButton") then
		statsCloseBtn.Text = I18n.t("UI_CLOSE")
	end
	local pAtk = 28 + (playerState.level - 1) * 7 + classData.baseAtkBonus
	local pDef = (localPlayer:GetAttribute("PDef") :: number?) or classData.basePDef
	local critRate = math.floor(20 * raceData.critMult + 0.5)
	local atkSpd = math.floor(300 * raceData.atkSpdMult + 0.5)
	local moveSpd = math.floor(16 * raceData.moveSpeedMult * 10 + 0.5) / 10

	statsContentLabel.Text = string.format(
		"• %s  |  %s (%s)\n• %s: %d / %d\n• %s: %d / %d\n• %s: %d\n• %s: %d\n• %s: %d%%\n• %s: %d\n• %s: %.1f",
		I18n.t("UI_LEVEL", { lv = playerState.level }),
		I18n.t(classData.nameKey),
		I18n.t(raceData.nameKey),
		I18n.t("UI_HP"),
		playerState.hp,
		playerState.maxHp,
		I18n.t("UI_MP"),
		playerState.mp,
		playerState.maxMp,
		I18n.t("UI_STAT_ATK"),
		pAtk,
		I18n.t("UI_STAT_PDEF"),
		pDef,
		I18n.t("UI_STAT_CRIT"),
		critRate,
		I18n.t("UI_STAT_ATKSPD"),
		atkSpd,
		I18n.t("UI_STAT_MOVESPD"),
		moveSpd
	)

	refreshCharacterCreationScreen()
end

local function refreshPlayerHud()
	hudLevelBadge.Text = tostring(playerState.level)
	hudPlayerNameLabel.Text = localPlayer.DisplayName

	local classData = ClassesConfig[playerState.classId]
	local raceData = RacesConfig[playerState.raceId :: RacesConfig.RaceId]
	local className = if classData then I18n.t(classData.nameKey) else playerState.classId
	local raceName = if raceData then I18n.t(raceData.nameKey) else playerState.raceId
	hudClassRaceSubtitle.Text = string.format("%s • %s", className, raceName)

	local hpRatio = math.clamp(playerState.hp / math.max(1, playerState.maxHp), 0, 1)
	TweenService:Create(
		hudHpFill,
		TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(hpRatio, 1) }
	):Play()
	hudHpText.Text = string.format("%s: %d / %d (%.0f%%)", I18n.t("UI_HP"), playerState.hp, playerState.maxHp, hpRatio * 100)

	local mpRatio = math.clamp(playerState.mp / math.max(1, playerState.maxMp), 0, 1)
	TweenService:Create(
		hudMpFill,
		TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(mpRatio, 1) }
	):Play()
	hudMpText.Text = string.format("%s: %d / %d (%.0f%%)", I18n.t("UI_MP"), playerState.mp, playerState.maxMp, mpRatio * 100)

	local expRatio = math.clamp(playerState.exp / math.max(1, playerState.maxExp), 0, 1)
	local expPercent = expRatio * 100
	TweenService:Create(
		hudExpFill,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(expRatio, 1) }
	):Play()
	hudExpText.Text = string.format("%s: %.1f%% (%d / %d)", I18n.t("UI_EXP"), expPercent, playerState.exp, playerState.maxExp)

	minimapLocationLabel.Text = I18n.t("LOC_CENTRAL_STATION")
	chatInputBox.PlaceholderText = I18n.t("UI_CHAT_PLACEHOLDER")

	btnInventory.Text = I18n.t("UI_BTN_INVENTORY")
	btnJob.Text = I18n.t("UI_BTN_JOB")
	btnStats.Text = I18n.t("UI_BTN_STATS")
	btnLang.Text = I18n.t("UI_BTN_LANG", { lang = string.upper(I18n.GetLanguage()) })

	refreshHotbarLabels()
	refreshModals()
end

local function toggleModal(targetModal: Frame)
	if charCreationScreen and charCreationScreen.Visible then
		return
	end
	local willShow = not targetModal.Visible
	inventoryModal.Visible = false
	jobModalFrame.Visible = false
	statsModal.Visible = false
	targetModal.Visible = willShow
	if willShow then
		refreshModals()
	end
end

