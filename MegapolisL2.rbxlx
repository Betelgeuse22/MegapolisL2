  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = Shared:WaitForChild("configs")

local GameConstants = require(Configs:WaitForChild("GameConstants"))
local MobsConfig = require(Configs:WaitForChild("MobsConfig"))
local RacesConfig = require(Configs:WaitForChild("RacesConfig"))
local ClassesConfig = require(Configs:WaitForChild("ClassesConfig"))
local SkillsConfig = require(Configs:WaitForChild("SkillsConfig"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local DataManager = require(script.Parent:WaitForChild("DataManager"))
local MobSpawnerService = require(script.Parent:WaitForChild("MobSpawnerService"))

export type ClassProgressEntry = {
	Level: number,
	Exp: number,
	MaxExp: number,
	BaseAtk: number,
	BaseMaxHP: number,
}

export type PlayerCombatState = {
	RaceId: RacesConfig.RaceId,
	ClassId: string,
	Level: number,
	Exp: number,
	MaxExp: number,
	Cash: number,
	TrashTokens: number,
	BaseAtk: number,
	BaseMaxHP: number,
	CritRate: number,
	MaxHP: number,
	MP: number,
	MaxMP: number,
	PDef: number,
	PDefMult: number,
	AtkSpdMult: number,
	CritBonus: number,
	CashMult: number,
	WalkSpeedMult: number,
	ClassProgress: { [string]: ClassProgressEntry },
	SkillCooldowns: { [string]: number },
	SelectedTarget: Model?,
	LastAttackTime: number,
}

local BASE_ATTACK_COOLDOWN = 0.42
local MAX_ATTACK_DISTANCE = 20
local SKILL_AUTO_TARGET_DISTANCE = 30
local BASE_WALK_SPEED = 16

-- Explicit ordered skill table per playable class (Index 1="Q", 2="E", 3="R", 4="F")
local CLASS_SKILL_ORDER: { [string]: { string } } = {
	RiotPolice = {
		"SKILL_BATON_STUN",
		"SKILL_MEGAPHONE_AGGRO",
		"SKILL_WATER_CANNON",
		"SKILL_RIOT_SHIELD",
	},
	HellsSousChef = {
		"SKILL_SLICE_DICE",
		"SKILL_IRON_PAN",
		"SKILL_FLAMBE",
		"SKILL_FRIDAY_RUSH",
	},
	RecycleHunter = {
		"SKILL_SPOIL",
		"SKILL_SWEEP",
		"SKILL_CART_RAM",
		"SKILL_MONOPOLY",
	},
}

local SLOT_TO_INDEX: { [string]: number } = {
	Q = 1,
	E = 2,
	R = 3,
	F = 4,
	["1"] = 1,
	["2"] = 2,
	["3"] = 3,
	["4"] = 4,
}

local CombatService = {}

local playerStates: { [Player]: PlayerCombatState } = {}
local initialized = false

local function computeBaseStatsForLevel(level: number): (number, number, number)
	local clamped = math.clamp(math.floor(level), 1, GameConstants.MAX_LEVEL)
	local baseAtk = 28 + (clamped - 1) * 7
	local baseMaxHp = 120 + (clamped - 1) * 25
	local maxExp = GameConstants.GetRequiredExp(clamped)
	return baseAtk, baseMaxHp, maxExp
end

local function getCharacterHealth(player: Player, fallbackMaxHp: number): (number, number)
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return math.max(0, math.floor(humanoid.Health + 0.5)), math.max(1, math.floor(humanoid.MaxHealth + 0.5))
		end
	end
	return fallbackMaxHp, fallbackMaxHp
end

local function sendSystemChat(
	player: Player,
	i18nKey: string,
	params: { [string]: any }?,
	r: number,
	g: number,
	b: number
)
	Remotes.SendChatMessage:FireClient(player, i18nKey, params or {}, { r, g, b })
end

local function syncStateIntoProfile(player: Player)
	local state = playerStates[player]
	if not state then
		return
	end
	local profile = DataManager.GetProfile(player)
	profile.RaceId = state.RaceId
	profile.CurrentClassId = state.ClassId
	profile.Cash = state.Cash
	profile.TrashTokens = state.TrashTokens

	local hp, _ = getCharacterHealth(player, state.MaxHP)
	if profile.IsCharacterCreated and profile.UnlockedClasses[state.ClassId] then
		profile.ClassProgress[state.ClassId] = {
			Level = state.Level,
			Exp = state.Exp,
			HP = math.max(1, hp),
			MP = state.MP,
		}
	end

	state.ClassProgress[state.ClassId] = {
		Level = state.Level,
		Exp = state.Exp,
		MaxExp = state.MaxExp,
		BaseAtk = state.BaseAtk,
		BaseMaxHP = state.BaseMaxHP,
	}
end

function CombatService.SyncProfile(player: Player)
	syncStateIntoProfile(player)
	local profile = DataManager.GetProfile(player)
	Remotes.ProfileUpdated:FireClient(player, profile)
end

local function createWeaponPart(
	name: string,
	size: Vector3,
	color: Color3,
	material: Enum.Material,
	parent: Instance
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Anchored = false
	part.Parent = parent
	return part
end

local function weldParts(part0: BasePart, part1: BasePart, offsetCFrame: CFrame)
	part1.CFrame = part0.CFrame * offsetCFrame
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = part0
	weld.Part1 = part1
	weld.Parent = part1
end

function CombatService.EquipClassWeapon(player: Player, classId: string)
	local character = player.Character
	if not character then
		return
	end

	local existingWeapon = character:FindFirstChild("EquippedClassWeapon")
	if existingWeapon then
		existingWeapon:Destroy()
	end

	local rightHand = (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")) :: BasePart?
	if not rightHand then
		return
	end

	local weaponModel = Instance.new("Model")
	weaponModel.Name = "EquippedClassWeapon"
	weaponModel.Parent = character

	local handle = createWeaponPart(
		"Handle",
		Vector3.new(0.28, 1.1, 0.28),
		Color3.fromRGB(30, 32, 38),
		Enum.Material.SmoothPlastic,
		weaponModel
	)
	weaponModel.PrimaryPart = handle

	local handOffset = if rightHand.Name == "RightHand"
		then CFrame.new(0, -0.15, -0.45) * CFrame.Angles(math.rad(-90), 0, 0)
		else CFrame.new(0, -0.95, -0.45) * CFrame.Angles(math.rad(-90), 0, 0)
	weldParts(rightHand, handle, handOffset)

	local tipOffset = Vector3.new(0, 2.2, 0)

	if classId == "RiotPolice" then
		local guard = createWeaponPart(
			"Guard",
			Vector3.new(0.45, 0.16, 0.9),
			Color3.fromRGB(20, 22, 26),
			Enum.Material.Metal,
			weaponModel
		)
		weldParts(handle, guard, CFrame.new(0, 0.45, 0.2))

		local shaft = createWeaponPart(
			"BatonShaft",
			Vector3.new(2.1, 0.32, 0.32),
			Color3.fromRGB(18, 20, 25),
			Enum.Material.SmoothPlastic,
			weaponModel
		)
		shaft.Shape = Enum.PartType.Cylinder
		weldParts(handle, shaft, CFrame.new(0, 1.45, 0) * CFrame.Angles(0, 0, math.rad(90)))

		local stunTip = createWeaponPart(
			"StunTip",
			Vector3.new(0.36, 0.25, 0.36),
			Color3.fromRGB(0, 210, 255),
			Enum.Material.Neon,
			weaponModel
		)
		weldParts(handle, stunTip, CFrame.new(0, 2.45, 0))
		tipOffset = Vector3.new(0, 2.55, 0)
	elseif classId == "HellsSousChef" then
		local blade = createWeaponPart(
			"CleaverBlade",
			Vector3.new(0.14, 1.65, 0.95),
			Color3.fromRGB(200, 208, 220),
			Enum.Material.Metal,
			weaponModel
		)
		weldParts(handle, blade, CFrame.new(0, 1.35, -0.18))

		local heatedEdge = createWeaponPart(
			"HeatedEdge",
			Vector3.new(0.16, 1.65, 0.15),
			Color3.fromRGB(255, 115, 30),
			Enum.Material.Neon,
			weaponModel
		)
		weldParts(handle, heatedEdge, CFrame.new(0, 1.35, -0.62))
		tipOffset = Vector3.new(0, 2.25, -0.3)
	else
		local scannerBox = createWeaponPart(
			"ScannerBox",
			Vector3.new(0.42, 0.55, 0.52),
			Color3.fromRGB(50, 65, 80),
			Enum.Material.Metal,
			weaponModel
		)
		weldParts(handle, scannerBox, CFrame.new(0, 0.65, 0))

		local rod = createWeaponPart(
			"HarvesterRod",
			Vector3.new(0.22, 1.45, 0.22),
			Color3.fromRGB(150, 165, 180),
			Enum.Material.Metal,
			weaponModel
		)
		weldParts(handle, rod, CFrame.new(0, 1.55, 0))

		local hook = createWeaponPart(
			"LaserHook",
			Vector3.new(0.2, 0.45, 0.85),
			Color3.fromRGB(0, 245, 200),
			Enum.Material.Neon,
			weaponModel
		)
		weldParts(handle, hook, CFrame.new(0, 2.2, -0.32))
		tipOffset = Vector3.new(0, 2.35, -0.45)
	end

	local att0 = Instance.new("Attachment")
	att0.Name = "TrailBase"
	att0.Position = Vector3.new(0, 0.4, 0)
	att0.Parent = handle

	local att1 = Instance.new("Attachment")
	att1.Name = "TrailTip"
	att1.Position = tipOffset
	att1.Parent = handle

	local trail = Instance.new("Trail")
	trail.Name = "WeaponTrail"
	trail.Attachment0 = att0
	trail.Attachment1 = att1
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1.0),
	})
	trail.Lifetime = 0.18
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.Enabled = false
	trail.Parent = weaponModel
end

function CombatService.RecalculateStats(player: Player, healToFull: boolean)
	local state = playerStates[player]
	if not state then
		return
	end

	local raceData = RacesConfig[state.RaceId] or RacesConfig.RACE_LAW
	local classData = ClassesConfig[state.ClassId] or ClassesConfig.RiotPolice

	local computedMaxHp = math.floor((state.BaseMaxHP + classData.baseHpBonus) * raceData.hpMult + 0.5)
	local computedPDef = math.floor(classData.basePDef * state.PDefMult + 0.5)
	state.MaxHP = math.max(50, computedMaxHp)
	state.MaxMP = 100 + (state.Level - 1) * 20
	if healToFull then
		state.MP = state.MaxMP
	else
		state.MP = math.clamp(state.MP, 0, state.MaxMP)
	end
	state.PDef = math.max(1, computedPDef)

	player:SetAttribute("Level", state.Level)
	player:SetAttribute("RaceId", state.RaceId)
	player:SetAttribute("ClassId", state.ClassId)
	player:SetAttribute("TrashTokens", state.TrashTokens)
	player:SetAttribute("PDef", state.PDef)
	player:SetAttribute("MP", state.MP)
	player:SetAttribute("MaxMP", state.MaxMP)

	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local prevMax = math.max(1, humanoid.MaxHealth)
			local prevRatio = math.clamp(humanoid.Health / prevMax, 0, 1)
			humanoid.MaxHealth = state.MaxHP
			if healToFull then
				humanoid.Health = state.MaxHP
			else
				humanoid.Health = math.max(1, math.floor(state.MaxHP * prevRatio + 0.5))
			end
			humanoid.WalkSpeed = BASE_WALK_SPEED * raceData.moveSpeedMult * state.WalkSpeedMult
		end
	end

	CombatService.SyncPlayerStats(player)
end

function CombatService.SyncPlayerStats(player: Player)
	local state = playerStates[player]
	if not state then
		return
	end
	local hp, maxHp = getCharacterHealth(player, state.MaxHP)
	Remotes.PlayerStatsUpdated:FireClient(
		player,
		state.Level,
		state.Exp,
		state.MaxExp,
		state.Cash,
		hp,
		maxHp,
		state.RaceId,
		state.ClassId,
		state.TrashTokens,
		state.MP,
		state.MaxMP
	)
end

local function setupPlayer(player: Player): PlayerCombatState
	if playerStates[player] then
		return playerStates[player]
	end

	local profile = DataManager.LoadProfile(player)
	local initialClass = if ClassesConfig[profile.CurrentClassId] and ClassesConfig[profile.CurrentClassId].isPlayableSprint2
		then profile.CurrentClassId
		else "RiotPolice"
	local initialRace: RacesConfig.RaceId = if RacesConfig[profile.RaceId :: RacesConfig.RaceId]
		then (profile.RaceId :: RacesConfig.RaceId)
		else "RACE_LAW"

	local savedEntry = profile.ClassProgress[initialClass]
	local startLevel = if savedEntry then math.clamp(savedEntry.Level, 1, GameConstants.MAX_LEVEL) else 1
	local startExp = if savedEntry then math.max(0, savedEntry.Exp) else 0
	local baseAtk, baseMaxHp, maxExp = computeBaseStatsForLevel(startLevel)

	local classProgressMap: { [string]: ClassProgressEntry } = {}
	for cId, cSaved in pairs(profile.ClassProgress) do
		local cLv = math.clamp(cSaved.Level, 1, GameConstants.MAX_LEVEL)
		local cAtk, cHp, cMaxExp = computeBaseStatsForLevel(cLv)
		classProgressMap[cId] = {
			Level = cLv,
			Exp = math.max(0, cSaved.Exp),
			MaxExp = cMaxExp,
			BaseAtk = cAtk,
			BaseMaxHP = cHp,
		}
	end
	if not classProgressMap[initialClass] then
		classProgressMap[initialClass] = {
			Level = startLevel,
			Exp = startExp,
			MaxExp = maxExp,
			BaseAtk = baseAtk,
			BaseMaxHP = baseMaxHp,
		}
	end

	local state: PlayerCombatState = {
		RaceId = initialRace,
		ClassId = initialClass,
		Level = startLevel,
		Exp = startExp,
		MaxExp = maxExp,
		Cash = profile.Cash,
		TrashTokens = profile.TrashTokens,
		BaseAtk = baseAtk,
		BaseMaxHP = baseMaxHp,
		CritRate = 0.20,
		MaxHP = 180,
		MP = if savedEntry and savedEntry.MP > 0 then savedEntry.MP else 100,
		MaxMP = 100 + (startLevel - 1) * 20,
		PDef = 45,
		PDefMult = 1.0,
		AtkSpdMult = 1.0,
		CritBonus = 0.0,
		CashMult = 1.0,
		WalkSpeedMult = 1.0,
		ClassProgress = classProgressMap,
		SkillCooldowns = {},
		SelectedTarget = nil,
		LastAttackTime = 0,
	}
	playerStates[player] = state

	local function onCharacterReady(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if humanoid then
			task.wait(0.1)
			CombatService.EquipClassWeapon(player, state.ClassId)
			CombatService.RecalculateStats(player, true)
			CombatService.SyncProfile(player)
			humanoid.HealthChanged:Connect(function()
				CombatService.SyncPlayerStats(player)
			end)
		end
	end

	player.CharacterAdded:Connect(onCharacterReady)
	if player.Character then
		task.spawn(onCharacterReady, player.Character)
	else
		CombatService.SyncPlayerStats(player)
		CombatService.SyncProfile(player)
	end

	-- Also send a delayed sync so client UIController listeners that connect shortly after PlayerAdded always receive the profile snapshot
	task.delay(0.5, function()
		if player.Parent == Players then
			CombatService.SyncPlayerStats(player)
			CombatService.SyncProfile(player)
		end
	end)

	return state
end

function CombatService.GetPlayerState(player: Player): PlayerCombatState
	return playerStates[player] or setupPlayer(player)
end

function CombatService.GetEffectiveAttackStats(player: Player): (number, number, number)
	local state = CombatService.GetPlayerState(player)
	local raceData = RacesConfig[state.RaceId] or RacesConfig.RACE_LAW
	local classData = ClassesConfig[state.ClassId] or ClassesConfig.RiotPolice

	local effectiveAtk = state.BaseAtk + classData.baseAtkBonus
	local effectiveCrit = math.clamp(state.CritRate * raceData.critMult + state.CritBonus, 0.05, 0.90)
	local effectiveAtkSpd = raceData.atkSpdMult * state.AtkSpdMult
	return effectiveAtk, effectiveCrit, effectiveAtkSpd
end

function CombatService.AwardKillRewards(player: Player, mobId: string, mobLevel: number)
	local state = CombatService.GetPlayerState(player)
	local mobData = MobsConfig[mobId]
	if not mobData then
		return
	end

	local penalty = GameConstants.CalculateLevelPenalty(state.Level, mobLevel)
	local gainedExp = math.max(1, math.floor(mobData.expReward * penalty + 0.5))
	local gainedCash = math.max(1, math.floor(mobData.cashReward * state.CashMult + 0.5))

	state.Cash += gainedCash

	local leveledUp = false
	if state.Level < GameConstants.MAX_LEVEL then
		state.Exp += gainedExp
		while state.Level < GameConstants.MAX_LEVEL and state.Exp >= state.MaxExp do
			state.Exp -= state.MaxExp
			state.Level += 1
			local newAtk, newBaseHp, newMaxExp = computeBaseStatsForLevel(state.Level)
			state.BaseAtk = newAtk
			state.BaseMaxHP = newBaseHp
			state.MaxExp = newMaxExp
			leveledUp = true
		end
		if state.Level >= GameConstants.MAX_LEVEL then
			state.Level = GameConstants.MAX_LEVEL
			state.Exp = 0
		end
	else
		state.Exp = 0
	end

	syncStateIntoProfile(player)

	if leveledUp then
		CombatService.RecalculateStats(player, true)
		DataManager.SaveProfile(player)
	else
		CombatService.SyncPlayerStats(player)
	end
	CombatService.SyncProfile(player)
end

-- Unified Authoritative Damage & Death Function used by BOTH LMB attacks and ALL Skills
function CombatService.ApplyDamageToMob(
	attacker: Player,
	mobModel: Model,
	rawDamage: number,
	isSkill: boolean
): (number, boolean)
	local state = CombatService.GetPlayerState(attacker)
	if not mobModel or not mobModel.Parent then
		return 0, false
	end

	local mobState = MobSpawnerService.GetMobState(mobModel)
	local currentHp = if mobState then mobState.currentHp else ((mobModel:GetAttribute("CurrentHP") :: number?) or 0)
	if currentHp <= 0 or (mobState and mobState.isDead) then
		return 0, false
	end

	local mobLevel = (mobModel:GetAttribute("Level") :: number?) or 1
	local mobPDef = (mobModel:GetAttribute("PDef") :: number?) or 10
	local mobId = (mobModel:GetAttribute("MobId") :: string?) or mobModel.Name

	local _, effectiveCrit = CombatService.GetEffectiveAttackStats(attacker)
	local mitigated = rawDamage * (100 / (100 + mobPDef))

	local isCrit = math.random() < effectiveCrit
	if isCrit then
		mitigated *= 2.0
	end

	local levelPenalty = GameConstants.CalculateLevelPenalty(state.Level, mobLevel)
	local finalDamage = math.max(1, math.floor(mitigated * levelPenalty + 0.5))

	local newHp = math.max(0, currentHp - finalDamage)
	if mobState then
		mobState.currentHp = newHp
	end
	mobModel:SetAttribute("CurrentHP", newHp)

	local mobHumanoid = mobModel:FindFirstChildOfClass("Humanoid")
	if mobHumanoid then
		mobHumanoid.Health = newHp
	end

	MobSpawnerService.AddHate(mobModel, attacker, if isSkill then finalDamage * 2 else finalDamage)
	Remotes.CombatHitFeedback:FireAllClients(mobModel, finalDamage, isCrit, false)

	local killed = false
	if newHp <= 0 then
		killed = true

		-- Collect killer + all players on HateList BEFORE HandleMobDeath clears hateList
		local participants: { [Player]: boolean } = {
			[attacker] = true,
		}
		if mobState then
			for hatedPlayer, hateAmount in pairs(mobState.hateList) do
				if hateAmount > 0 and hatedPlayer.Parent == Players then
					participants[hatedPlayer] = true
				end
			end
		end

		MobSpawnerService.HandleMobDeath(mobModel)
		CombatService.AwardKillRewards(attacker, mobId, mobLevel)

		-- Subclass Raid Boss Kill Tracking
		local bossReq = GameConstants.SUBCLASS_BOSS_BY_ID[mobId]
		if bossReq then
			for participant, _ in pairs(participants) do
				if participant.Parent == Players then
					local updatedKills = DataManager.IncrementBossKill(participant, mobId)
					sendSystemChat(
						participant,
						"LOG_BOSS_KILL_PROGRESS",
						{
							bossKey = bossReq.nameKey,
							cur = updatedKills,
							req = bossReq.requiredKills,
						},
						255,
						215,
						75
					)
					CombatService.SyncProfile(participant)
					DataManager.SaveProfile(participant)
				end
			end
		end
	end

	return finalDamage, killed
end

function CombatService.DealDamageToMob(
	player: Player,
	targetModel: Model,
	damageMultiplier: number,
	isSkill: boolean?
): (number, boolean, boolean)
	local effectiveAtk = CombatService.GetEffectiveAttackStats(player)
	local rawDamage = effectiveAtk * damageMultiplier
	local finalDamage, killed = CombatService.ApplyDamageToMob(player, targetModel, rawDamage, isSkill == true)
	return finalDamage, false, killed
end

function CombatService.CreateCharacter(player: Player, raceId: string, startingClassId: string)
	local state = CombatService.GetPlayerState(player)
	local profile = DataManager.GetProfile(player)

	local validRaceId: RacesConfig.RaceId = if RacesConfig[raceId :: RacesConfig.RaceId]
		then (raceId :: RacesConfig.RaceId)
		else "RACE_LAW"
	local validClassId = if ClassesConfig[startingClassId] and ClassesConfig[startingClassId].isPlayableSprint2
		then startingClassId
		else "RiotPolice"

	local baseAtk, baseMaxHp, maxExp = computeBaseStatsForLevel(1)

	state.RaceId = validRaceId
	state.ClassId = validClassId
	state.Level = 1
	state.Exp = 0
	state.MaxExp = maxExp
	state.BaseAtk = baseAtk
	state.BaseMaxHP = baseMaxHp
	state.PDefMult = 1.0
	state.AtkSpdMult = 1.0
	state.CritBonus = 0.0
	state.CashMult = 1.0
	state.WalkSpeedMult = 1.0
	table.clear(state.SkillCooldowns)

	state.ClassProgress = {
		[validClassId] = {
			Level = 1,
			Exp = 0,
			MaxExp = maxExp,
			BaseAtk = baseAtk,
			BaseMaxHP = baseMaxHp,
		},
	}

	profile.IsCharacterCreated = true
	profile.RaceId = validRaceId
	profile.CurrentClassId = validClassId
	profile.UnlockedClasses = {
		[validClassId] = true,
	}
	profile.ClassProgress = {
		[validClassId] = {
			Level = 1,
			Exp = 0,
			HP = state.MaxHP,
			MP = 100,
		},
	}

	CombatService.EquipClassWeapon(player, state.ClassId)
	CombatService.RecalculateStats(player, true)
	CombatService.SyncProfile(player)
	DataManager.SaveProfile(player)

	local cData = ClassesConfig[validClassId]
	local rData = RacesConfig[validRaceId]
	sendSystemChat(
		player,
		"LOG_CHAR_CREATED",
		{
			classKey = if cData then cData.nameKey else validClassId,
			raceKey = if rData then rData.nameKey else validRaceId,
		},
		120,
		255,
		150
	)
end

function CombatService.UnlockOrSwitchSubclass(player: Player, targetClassId: string)
	local state = CombatService.GetPlayerState(player)
	local profile = DataManager.GetProfile(player)

	if not profile.IsCharacterCreated then
		return
	end

	local targetClassData = ClassesConfig[targetClassId]
	if not targetClassData or not targetClassData.isPlayableSprint2 then
		return
	end

	if state.ClassId == targetClassId and profile.UnlockedClasses[targetClassId] == true then
		CombatService.SyncProfile(player)
		return
	end

	-- Save current class progress before switching
	syncStateIntoProfile(player)

	local isAlreadyUnlocked = profile.UnlockedClasses[targetClassId] == true
	if not isAlreadyUnlocked then
		-- Verify Subclass Quest conditions: MaxReachedLevel >= 40 and all 4 BossKills >= 3
		if not DataManager.AreSubclassRequirementsMet(player) then
			sendSystemChat(player, "LOG_SUBCLASS_LOCKED", {}, 255, 95, 95)
			CombatService.SyncProfile(player)
			return
		end

		-- Unlock new Subclass at Lv. 1!
		profile.UnlockedClasses[targetClassId] = true
		local baseAtk, baseMaxHp, maxExp = computeBaseStatsForLevel(1)
		profile.ClassProgress[targetClassId] = {
			Level = 1,
			Exp = 0,
			HP = baseMaxHp,
			MP = 100,
		}
		state.ClassProgress[targetClassId] = {
			Level = 1,
			Exp = 0,
			MaxExp = maxExp,
			BaseAtk = baseAtk,
			BaseMaxHP = baseMaxHp,
		}

		sendSystemChat(
			player,
			"LOG_SUBCLASS_UNLOCKED",
			{
				classKey = targetClassData.nameKey,
			},
			115,
			255,
			145
		)
	end

	-- Switch to the unlocked class and restore its independent Level & EXP
	local savedProfileProgress = profile.ClassProgress[targetClassId]
	local restoredLevel = if savedProfileProgress
		then math.clamp(savedProfileProgress.Level, 1, GameConstants.MAX_LEVEL)
		else 1
	local restoredExp = if savedProfileProgress then math.max(0, savedProfileProgress.Exp) else 0
	local baseAtk, baseMaxHp, maxExp = computeBaseStatsForLevel(restoredLevel)

	state.ClassId = targetClassId
	profile.CurrentClassId = targetClassId
	state.Level = restoredLevel
	state.Exp = restoredExp
	state.MaxExp = maxExp
	state.BaseAtk = baseAtk
	state.BaseMaxHP = baseMaxHp

	state.PDefMult = 1.0
	state.AtkSpdMult = 1.0
	state.CritBonus = 0.0
	state.CashMult = 1.0
	state.WalkSpeedMult = 1.0
	table.clear(state.SkillCooldowns)

	CombatService.EquipClassWeapon(player, state.ClassId)
	CombatService.RecalculateStats(player, true)
	CombatService.SyncProfile(player)
	DataManager.SaveProfile(player)
end

-- Legacy remote handler routes through Subclass Quest Gating (no unrestricted race/class switching)
function CombatService.ChangeClassOrRace(player: Player, newClassId: string?, _newRaceId: string?)
	if newClassId then
		CombatService.UnlockOrSwitchSubclass(player, newClassId)
	end
end

local function handleDeveloperChatCommand(player: Player, rawMessage: string): boolean
	local trimmed = string.gsub(rawMessage, "^%s*(.-)%s*$", "%1")
	if string.sub(trimmed, 1, 1) ~= "/" then
		return false
	end

	local parts = string.split(trimmed, " ")
	local cmd = string.lower(parts[1] or "")
	local state = CombatService.GetPlayerState(player)
	local profile = DataManager.GetProfile(player)

	if cmd == "/dev_sub" or cmd == "/dev_unlock" then
		local targetLv = math.max(state.Level, GameConstants.SUBCLASS_REQUIRED_LEVEL)
		local baseAtk, baseMaxHp, maxExp = computeBaseStatsForLevel(targetLv)
		state.Level = targetLv
		state.Exp = 0
		state.MaxExp = maxExp
		state.BaseAtk = baseAtk
		state.BaseMaxHP = baseMaxHp

		profile.IsCharacterCreated = true
		profile.UnlockedClasses[state.ClassId] = true
		profile.BossKills.PlatformBaron = math.max(3, profile.BossKills.PlatformBaron)
		profile.BossKills.BlackFridayGolem = math.max(3, profile.BossKills.BlackFridayGolem)
		profile.BossKills.NightclubKing = math.max(3, profile.BossKills.NightclubKing)
		profile.BossKills.InflationArchitect = math.max(3, profile.BossKills.InflationArchitect)

		CombatService.RecalculateStats(player, true)
		CombatService.SyncProfile(player)
		DataManager.SaveProfile(player)
		sendSystemChat(player, "LOG_DEV_SUB_READY", {}, 120, 255, 160)
		return true
	elseif cmd == "/dev_lv" then
		local lvArg = tonumber(parts[2])
		if not lvArg then
			return true
		end
		local targetLv = math.clamp(math.floor(lvArg), 1, GameConstants.MAX_LEVEL)
		local baseAtk, baseMaxHp, maxExp = computeBaseStatsForLevel(targetLv)
		state.Level = targetLv
		state.Exp = 0
		state.MaxExp = maxExp
		state.BaseAtk = baseAtk
		state.BaseMaxHP = baseMaxHp

		profile.IsCharacterCreated = true
		profile.UnlockedClasses[state.ClassId] = true

		CombatService.RecalculateStats(player, true)
		CombatService.SyncProfile(player)
		DataManager.SaveProfile(player)
		sendSystemChat(
			player,
			"LOG_DEV_LEVEL_SET",
			{
				lv = targetLv,
				maxExp = maxExp,
			},
			120,
			255,
			160
		)
		return true
	elseif cmd == "/dev_reset" then
		local freshProfile = DataManager.ResetProfile(player)
		local baseAtk, baseMaxHp, maxExp = computeBaseStatsForLevel(1)

		state.RaceId = "RACE_LAW"
		state.ClassId = "RiotPolice"
		state.Level = 1
		state.Exp = 0
		state.MaxExp = maxExp
		state.BaseAtk = baseAtk
		state.BaseMaxHP = baseMaxHp
		state.Cash = freshProfile.Cash
		state.TrashTokens = freshProfile.TrashTokens
		state.ClassProgress = {}
		table.clear(state.SkillCooldowns)

		CombatService.RecalculateStats(player, true)
		Remotes.ProfileUpdated:FireClient(player, freshProfile)
		sendSystemChat(player, "LOG_DEV_RESET", {}, 255, 215, 95)
		return true
	end

	return false
end

local function findClosestMobInWorkspace(origin: Vector3, maxRange: number, requireDeadSpoiled: boolean): Model?
	local activeMobsFolder = Workspace:FindFirstChild("ActiveMobs")
	if not activeMobsFolder then
		return nil
	end

	local bestMob: Model? = nil
	local bestDist = maxRange

	for _, child in ipairs(activeMobsFolder:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute("IsMob") == true then
			local mobState = MobSpawnerService.GetMobState(child)
			local hp = if mobState then mobState.currentHp else ((child:GetAttribute("CurrentHP") :: number?) or 0)
			local isSpoiled = (mobState and mobState.isSpoiled)
				or (child:GetAttribute("IsSpoiled") == true)
				or (child:GetAttribute("CanSweep") == true)

			local valid = if requireDeadSpoiled then (hp <= 0 and isSpoiled) else (hp > 0)
			if valid then
				local root = MobSpawnerService.GetMobRoot(child)
				if root then
					local dist = (root.Position - origin).Magnitude
					if dist <= bestDist then
						bestDist = dist
						bestMob = child
					end
				end
			end
		end
	end

	return bestMob
end

local function resolveAliveTarget(playerRoot: BasePart, passedTarget: any, stateTarget: Model?, maxRange: number): Model?
	local activeMobsFolder = Workspace:FindFirstChild("ActiveMobs")
	local candidates = { passedTarget, stateTarget }

	for _, cand in ipairs(candidates) do
		if typeof(cand) == "Instance" and cand:IsA("Model") then
			if (not activeMobsFolder or cand.Parent == activeMobsFolder) and cand:GetAttribute("IsMob") == true then
				local mobState = MobSpawnerService.GetMobState(cand)
				local hp = if mobState then mobState.currentHp else ((cand:GetAttribute("CurrentHP") :: number?) or 0)
				local root = MobSpawnerService.GetMobRoot(cand)
				if hp > 0 and root and (root.Position - playerRoot.Position).Magnitude <= maxRange then
					return cand
				end
			end
		end
	end

	return findClosestMobInWorkspace(playerRoot.Position, maxRange, false)
end

local function resolveDeadSpoiledTarget(
	playerRoot: BasePart,
	passedTarget: any,
	stateTarget: Model?,
	maxRange: number
): Model?
	local activeMobsFolder = Workspace:FindFirstChild("ActiveMobs")
	local candidates = { passedTarget, stateTarget }

	for _, cand in ipairs(candidates) do
		if typeof(cand) == "Instance" and cand:IsA("Model") then
			if (not activeMobsFolder or cand.Parent == activeMobsFolder) and cand:GetAttribute("IsMob") == true then
				local mobState = MobSpawnerService.GetMobState(cand)
				local hp = if mobState then mobState.currentHp else ((cand:GetAttribute("CurrentHP") :: number?) or 0)
				local isSpoiled = (mobState and mobState.isSpoiled)
					or (cand:GetAttribute("IsSpoiled") == true)
					or (cand:GetAttribute("CanSweep") == true)
				local root = MobSpawnerService.GetMobRoot(cand)
				if hp <= 0 and isSpoiled and root and (root.Position - playerRoot.Position).Magnitude <= maxRange then
					return cand
				end
			end
		end
	end

	return findClosestMobInWorkspace(playerRoot.Position, maxRange, true)
end

local function resolveSkillDataForPlayer(state: PlayerCombatState, slotOrSkillId: any): SkillsConfig.SkillData?
	local keyStr = tostring(slotOrSkillId or "")
	local upperKey = string.upper(keyStr)

	-- 1. Map "Q" -> 1, "E" -> 2, "R" -> 3, "F" -> 4
	local slotIndex = SLOT_TO_INDEX[upperKey]
	if slotIndex then
		local classSkills = CLASS_SKILL_ORDER[state.ClassId] or CLASS_SKILL_ORDER.RiotPolice
		local skillId = classSkills[slotIndex]
		if skillId and SkillsConfig[skillId] then
			return SkillsConfig[skillId]
		end
	end

	-- 2. Check ClassesConfig.skillSlots table
	local classData = ClassesConfig[state.ClassId]
	if classData and classData.skillSlots[upperKey] then
		local mappedId = classData.skillSlots[upperKey]
		if SkillsConfig[mappedId] then
			return SkillsConfig[mappedId]
		end
	end

	-- 3. Direct skillId lookup
	if SkillsConfig[keyStr] then
		return SkillsConfig[keyStr]
	end

	return nil
end

local function handleRequestAttack(player: Player, targetModel: any)
	local state = CombatService.GetPlayerState(player)

	local character = player.Character
	if not character then
		return
	end
	local playerHumanoid = character:FindFirstChildOfClass("Humanoid")
	local playerRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not playerHumanoid or not playerRoot or playerHumanoid.Health <= 0 then
		return
	end

	local _, _, effectiveAtkSpd = CombatService.GetEffectiveAttackStats(player)
	local cooldown = BASE_ATTACK_COOLDOWN / math.max(0.5, effectiveAtkSpd)
	local now = os.clock()
	if (now - state.LastAttackTime) < cooldown then
		return
	end

	local resolvedTarget = resolveAliveTarget(playerRoot, targetModel, state.SelectedTarget, MAX_ATTACK_DISTANCE)
	if not resolvedTarget then
		return
	end

	state.LastAttackTime = now
	state.SelectedTarget = resolvedTarget

	local effectiveAtk = CombatService.GetEffectiveAttackStats(player)
	CombatService.ApplyDamageToMob(player, resolvedTarget, effectiveAtk, false)
end

-- Single Authoritative Skill Execution Pipeline inside CombatService
function CombatService.ExecuteSkill(player: Player, slotOrSkillId: any, targetModelArg: any)
	local state = CombatService.GetPlayerState(player)

	local character = player.Character
	if not character then
		return
	end
	local playerHumanoid = character:FindFirstChildOfClass("Humanoid")
	local playerRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not playerHumanoid or not playerRoot or playerHumanoid.Health <= 0 then
		return
	end

	local skillData = resolveSkillDataForPlayer(state, slotOrSkillId)
	if not skillData then
		warn("[CombatService] Could not resolve skill for", player.Name, "class:", state.ClassId, "slot:", slotOrSkillId)
		return
	end

	local now = os.clock()
	local readyAt = state.SkillCooldowns[skillData.id] or 0
	if now < readyAt then
		return
	end

	local searchRange = math.max(SKILL_AUTO_TARGET_DISTANCE, skillData.range)

	-- ====================================================
	-- 1. SKILL_SWEEP (DeadSpoiledTarget)
	-- ====================================================
	if skillData.targetType == "DeadSpoiledTarget" then
		local corpse = resolveDeadSpoiledTarget(playerRoot, targetModelArg, state.SelectedTarget, searchRange)
		if not corpse then
			Remotes.SkillVFX:FireClient(player, "NO_TARGET", player, {
				skillId = skillData.id,
			})
			return
		end

		local corpseRoot = MobSpawnerService.GetMobRoot(corpse)
		local corpsePos = if corpseRoot then corpseRoot.Position else playerRoot.Position
		local sweptOk, mobData = MobSpawnerService.SweepCorpse(corpse)
		if not sweptOk or not mobData then
			return
		end

		state.SkillCooldowns[skillData.id] = now + skillData.cooldown
		if state.MP < skillData.mpCost then
			state.MP = state.MaxMP
		end
		state.MP = math.max(0, state.MP - skillData.mpCost)

		local gainedTokens = math.max(1, math.floor((mobData.level * 2 + math.random(1, 3)) * state.CashMult + 0.5))
		local bonusCash = math.max(5, math.floor(mobData.cashReward * 0.85 * state.CashMult + 0.5))

		state.TrashTokens += gainedTokens
		state.Cash += bonusCash
		player:SetAttribute("TrashTokens", state.TrashTokens)
		CombatService.SyncPlayerStats(player)
		CombatService.SyncProfile(player)

		print(
			string.format(
				"[CombatService] SKILL_SWEEP harvested %s -> +%d TrashTokens, +$%d Cash",
				mobData.id,
				gainedTokens,
				bonusCash
			)
		)

		Remotes.SkillVFX:FireAllClients(skillData.id, player, {
			targetPosition = corpsePos,
			tokens = gainedTokens,
			cash = bonusCash,
		})
		return
	end

	-- ====================================================
	-- 2. SingleTarget Skills (Baton Stun, Slice & Dice, Iron Pan, Spoil, Cart Ram)
	-- ====================================================
	if skillData.targetType == "SingleTarget" then
		local targetMob = resolveAliveTarget(playerRoot, targetModelArg, state.SelectedTarget, searchRange)
		if not targetMob then
			Remotes.SkillVFX:FireClient(player, "NO_TARGET", player, {
				skillId = skillData.id,
			})
			return
		end

		local mobRoot = MobSpawnerService.GetMobRoot(targetMob)
		if not mobRoot then
			return
		end

		state.SelectedTarget = targetMob
		state.SkillCooldowns[skillData.id] = now + skillData.cooldown

		-- Deduct MP and sync HUD
		if state.MP < skillData.mpCost then
			state.MP = state.MaxMP
		end
		state.MP = math.max(0, state.MP - skillData.mpCost)
		CombatService.SyncPlayerStats(player)

		-- SKILL_SPOIL
		if skillData.id == "SKILL_SPOIL" then
			local alreadySpoiled = targetMob:GetAttribute("IsSpoiled") == true
			MobSpawnerService.MarkMobSpoiled(targetMob)
			MobSpawnerService.AddHate(targetMob, player, 100)

			local effectiveAtk = CombatService.GetEffectiveAttackStats(player)
			local dealt = CombatService.ApplyDamageToMob(
				player,
				targetMob,
				effectiveAtk * (skillData.damageMult or 0.45),
				true
			)

			local statusKey = if alreadySpoiled then "MSG_SPOIL_ALREADY" else "MSG_SPOIL_SUCCESS"
			print(string.format("[CombatService] SKILL_SPOIL on %s (dmg=%d, status=%s)", targetMob.Name, dealt, statusKey))

			Remotes.SkillVFX:FireAllClients(skillData.id, player, {
				targetModel = targetMob,
				statusKey = statusKey,
				damage = dealt,
			})
			return
		end

		-- Gap-close / step towards target if slightly far so melee skills feel snappy
		local dist = (mobRoot.Position - playerRoot.Position).Magnitude
		if (skillData.id == "SKILL_CART_RAM" or dist > 10) and dist > 4.5 then
			local flatToMob = Vector3.new(mobRoot.Position.X - playerRoot.Position.X, 0, mobRoot.Position.Z - playerRoot.Position.Z)
			if flatToMob.Magnitude > 0.1 then
				local stepDist = if skillData.id == "SKILL_CART_RAM"
					then math.max(0, dist - 4.0)
					else math.min(6.0, math.max(0, dist - 5.0))
				local newPos = playerRoot.Position + flatToMob.Unit * stepDist
				playerRoot.CFrame = CFrame.lookAt(newPos, Vector3.new(mobRoot.Position.X, newPos.Y, mobRoot.Position.Z))
			end
		end

		local effectiveAtk = CombatService.GetEffectiveAttackStats(player)
		local hits = skillData.hitCount or 1
		local perHitRawDamage = (effectiveAtk * (skillData.damageMult or 1.4)) / hits

		local totalDealt = CombatService.ApplyDamageToMob(player, targetMob, perHitRawDamage, true)
		if hits > 1 then
			for hitIndex = 2, hits do
				task.delay((hitIndex - 1) * 0.12, function()
					if targetMob.Parent then
						CombatService.ApplyDamageToMob(player, targetMob, perHitRawDamage, true)
					end
				end)
			end
		end

		if skillData.stunDuration and skillData.stunDuration > 0 then
			MobSpawnerService.StunMob(targetMob, skillData.stunDuration)
		end

		if skillData.pDefDebuffMult and skillData.pDefDebuffDuration then
			MobSpawnerService.ApplyPDefDebuff(targetMob, skillData.pDefDebuffMult, skillData.pDefDebuffDuration)
		end

		if skillData.bleedDuration and skillData.bleedTickMult then
			local ticks = math.max(1, math.floor(skillData.bleedDuration))
			local tickMult = skillData.bleedTickMult
			task.spawn(function()
				for _ = 1, ticks do
					task.wait(1.0)
					if not targetMob.Parent then
						break
					end
					local hp = (targetMob:GetAttribute("CurrentHP") :: number?) or 0
					if hp <= 0 then
						break
					end
					local atkNow = CombatService.GetEffectiveAttackStats(player)
					CombatService.ApplyDamageToMob(player, targetMob, atkNow * tickMult, true)
				end
			end)
		end

		print(string.format("[CombatService] %s dealt %d damage to %s", skillData.id, totalDealt, targetMob.Name))

		Remotes.SkillVFX:FireAllClients(skillData.id, player, {
			targetModel = targetMob,
			targetPosition = mobRoot.Position,
			damage = totalDealt * hits,
		})
		return
	end

	-- ====================================================
	-- 3. SelfAoE Skills (SKILL_MEGAPHONE_AGGRO)
	-- ====================================================
	if skillData.targetType == "SelfAoE" then
		state.SkillCooldowns[skillData.id] = now + skillData.cooldown
		if state.MP < skillData.mpCost then
			state.MP = state.MaxMP
		end
		state.MP = math.max(0, state.MP - skillData.mpCost)
		CombatService.SyncPlayerStats(player)

		local origin = playerRoot.Position
		local effectiveAtk = CombatService.GetEffectiveAttackStats(player)
		local aoeRange = math.max(25, skillData.range)

		for mobModel, mobState in pairs(MobSpawnerService.GetAllActiveMobs()) do
			local mobRoot = MobSpawnerService.GetMobRoot(mobModel)
			if not mobState.isDead and mobRoot then
				local dist = (mobRoot.Position - origin).Magnitude
				if dist <= aoeRange then
					if skillData.aggroBonus and skillData.aggroBonus > 0 then
						MobSpawnerService.AddHate(mobModel, player, skillData.aggroBonus)
					end
					local mult = if skillData.damageMult and skillData.damageMult > 0 then skillData.damageMult else 0.5
					CombatService.ApplyDamageToMob(player, mobModel, effectiveAtk * mult, true)
				end
			end
		end

		Remotes.SkillVFX:FireAllClients(skillData.id, player, {
			origin = origin,
			radius = skillData.range,
		})
		return
	end

	-- ====================================================
	-- 4. FrontalCone / Beam Skills (SKILL_WATER_CANNON, SKILL_FLAMBE)
	-- ====================================================
	if skillData.targetType == "FrontalCone" then
		state.SkillCooldowns[skillData.id] = now + skillData.cooldown
		if state.MP < skillData.mpCost then
			state.MP = state.MaxMP
		end
		state.MP = math.max(0, state.MP - skillData.mpCost)
		CombatService.SyncPlayerStats(player)

		local origin = playerRoot.Position
		local lookVec = playerRoot.CFrame.LookVector

		local aimMob = resolveAliveTarget(playerRoot, targetModelArg, state.SelectedTarget, searchRange)
		if aimMob then
			state.SelectedTarget = aimMob
			local aimRoot = MobSpawnerService.GetMobRoot(aimMob)
			if aimRoot then
				local toTarget = Vector3.new(aimRoot.Position.X - origin.X, 0, aimRoot.Position.Z - origin.Z)
				if toTarget.Magnitude > 0.1 then
					lookVec = toTarget.Unit
					playerRoot.CFrame = CFrame.lookAt(origin, origin + lookVec)
				end
			end
		end

		local halfAngleRad = math.rad((skillData.coneAngleDeg or 85) * 0.5)
		local minDot = math.cos(halfAngleRad)
		local effectiveAtk = CombatService.GetEffectiveAttackStats(player)
		local rawSkillDamage = effectiveAtk * (skillData.damageMult or 1.60)
		local knockbackDistance = if skillData.id == "SKILL_WATER_CANNON"
			then 18
			else (skillData.knockbackDist or 0)

		local primaryDamage = 0
		for mobModel, mobState in pairs(MobSpawnerService.GetAllActiveMobs()) do
			local mobRoot = MobSpawnerService.GetMobRoot(mobModel)
			if not mobState.isDead and mobRoot then
				local delta = mobRoot.Position - origin
				local flatDelta = Vector3.new(delta.X, 0, delta.Z)
				local dist = flatDelta.Magnitude
				if dist <= searchRange then
					local flatLook = Vector3.new(lookVec.X, 0, lookVec.Z)
					local dot = if dist > 0.1 and flatLook.Magnitude > 0.1
						then flatDelta.Unit:Dot(flatLook.Unit)
						else 1
					if dot >= minDot or dist <= 7.0 or mobModel == aimMob then
						local dealt, killed = CombatService.ApplyDamageToMob(player, mobModel, rawSkillDamage, true)
						if primaryDamage == 0 then
							primaryDamage = dealt
						end
						if not killed and knockbackDistance > 0 then
							MobSpawnerService.KnockbackMob(mobModel, origin, knockbackDistance)
						end
					end
				end
			end
		end

		Remotes.SkillVFX:FireAllClients(skillData.id, player, {
			origin = origin,
			direction = lookVec,
			range = skillData.range,
			targetModel = aimMob,
			damage = primaryDamage,
		})
		return
	end

	-- ====================================================
	-- 5. SelfBuff Skills (SKILL_RIOT_SHIELD, SKILL_FRIDAY_RUSH, SKILL_MONOPOLY)
	-- ====================================================
	if skillData.targetType == "SelfBuff" then
		state.SkillCooldowns[skillData.id] = now + skillData.cooldown
		if state.MP < skillData.mpCost then
			state.MP = state.MaxMP
		end
		state.MP = math.max(0, state.MP - skillData.mpCost)

		local duration = skillData.buffDuration or 8.0
		local savedClassId = state.ClassId

		if skillData.buffPDefMult then
			state.PDefMult = skillData.buffPDefMult
		end
		if skillData.buffWalkSpeedMult then
			state.WalkSpeedMult = skillData.buffWalkSpeedMult
		end
		if skillData.buffAtkSpdMult then
			state.AtkSpdMult = skillData.buffAtkSpdMult
		end
		if skillData.buffCritBonus then
			state.CritBonus = skillData.buffCritBonus
		end
		if skillData.buffCashMult then
			state.CashMult = skillData.buffCashMult
		end

		CombatService.RecalculateStats(player, false)

		Remotes.SkillVFX:FireAllClients(skillData.id, player, {
			duration = duration,
		})

		task.delay(duration, function()
			local currentState = playerStates[player]
			if not currentState or currentState.ClassId ~= savedClassId then
				return
			end
			if skillData.buffPDefMult then
				currentState.PDefMult = 1.0
			end
			if skillData.buffWalkSpeedMult then
				currentState.WalkSpeedMult = 1.0
			end
			if skillData.buffAtkSpdMult then
				currentState.AtkSpdMult = 1.0
			end
			if skillData.buffCritBonus then
				currentState.CritBonus = 0.0
			end
			if skillData.buffCashMult then
				currentState.CashMult = 1.0
			end
			CombatService.RecalculateStats(player, false)
		end)
	end
end

function CombatService.Init()
	if initialized then
		return
	end
	initialized = true

	Players.PlayerAdded:Connect(setupPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		setupPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		syncStateIntoProfile(player)
		DataManager.SaveProfile(player)
		playerStates[player] = nil
	end)

	Remotes.SelectTarget.OnServerEvent:Connect(function(player: Player, mobModel: any)
		local state = CombatService.GetPlayerState(player)
		if typeof(mobModel) == "Instance" and mobModel:IsA("Model") and mobModel:GetAttribute("IsMob") == true then
			state.SelectedTarget = mobModel
		else
			state.SelectedTarget = nil
		end
	end)

	Remotes.RequestAttack.OnServerEvent:Connect(handleRequestAttack)

	Remotes.UseSkill.OnServerEvent:Connect(function(player: Player, slotOrSkillId: any, targetModel: any)
		CombatService.ExecuteSkill(player, slotOrSkillId, targetModel)
	end)

	Remotes.ChangeClassOrRace.OnServerEvent:Connect(function(player: Player, classId: any, raceId: any)
		local cleanClass = if type(classId) == "string" then classId else nil
		local cleanRace = if type(raceId) == "string" then raceId else nil
		CombatService.ChangeClassOrRace(player, cleanClass, cleanRace)
	end)

	Remotes.CreateCharacter.OnServerEvent:Connect(function(player: Player, raceId: any, startingClassId: any)
		local cleanRace = if type(raceId) == "string" then raceId else "RACE_LAW"
		local cleanClass = if type(startingClassId) == "string" then startingClassId else "RiotPolice"
		CombatService.CreateCharacter(player, cleanRace, cleanClass)
	end)

	Remotes.UnlockOrSwitchSubclass.OnServerEvent:Connect(function(player: Player, targetClassId: any)
		if type(targetClassId) == "string" then
			CombatService.UnlockOrSwitchSubclass(player, targetClassId)
		end
	end)

	Remotes.SendChatMessage.OnServerEvent:Connect(function(player: Player, rawMessage: any)
		if type(rawMessage) == "string" then
			handleDeveloperChatCommand(player, rawMessage)
		end
	end)

	-- Passive MP regeneration loop
	task.spawn(function()
		while true do
			task.wait(2.0)
			for player, state in pairs(playerStates) do
				if player.Parent == Players and state.MP < state.MaxMP then
					state.MP = math.min(state.MaxMP, state.MP + 6)
					CombatService.SyncPlayerStats(player)
				end
			end
		end
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = Shared:WaitForChild("configs")
local GameConstants = require(Configs:WaitForChild("GameConstants"))

export type SavedClassProgress = {
	Level: number,
	Exp: number,
	HP: number,
	MP: number,
}

export type BossKillCounts = {
	PlatformBaron: number,
	BlackFridayGolem: number,
	NightclubKing: number,
	InflationArchitect: number,
}

export type PlayerProfile = {
	IsCharacterCreated: boolean,
	RaceId: string,
	CurrentClassId: string,
	UnlockedClasses: { [string]: boolean },
	ClassProgress: { [string]: SavedClassProgress },
	BossKills: BossKillCounts,
	Cash: number,
	TrashTokens: number,
}

local DATASTORE_NAME = "MegapolisL2_Profiles_v2_5"

local DataManager = {}

local profileStore: GlobalDataStore? = nil
local activeProfiles: { [Player]: PlayerProfile } = {}
local memoryFallbackStore: { [string]: PlayerProfile } = {}
local initialized = false

local function getStore(): GlobalDataStore?
	if profileStore then
		return profileStore
	end
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)
	if ok and store then
		profileStore = store
		return store
	end
	return nil
end

local function createDefaultProfile(): PlayerProfile
	return {
		IsCharacterCreated = false,
		RaceId = "RACE_LAW",
		CurrentClassId = "RiotPolice",
		UnlockedClasses = {},
		ClassProgress = {},
		BossKills = {
			PlatformBaron = 0,
			BlackFridayGolem = 0,
			NightclubKing = 0,
			InflationArchitect = 0,
		},
		Cash = 0,
		TrashTokens = 0,
	}
end

local function deepCopyProfile(src: PlayerProfile): PlayerProfile
	local unlockedCopy: { [string]: boolean } = {}
	for k, v in pairs(src.UnlockedClasses) do
		unlockedCopy[k] = v == true
	end

	local progressCopy: { [string]: SavedClassProgress } = {}
	for k, v in pairs(src.ClassProgress) do
		progressCopy[k] = {
			Level = v.Level,
			Exp = v.Exp,
			HP = v.HP,
			MP = v.MP,
		}
	end

	return {
		IsCharacterCreated = src.IsCharacterCreated,
		RaceId = src.RaceId,
		CurrentClassId = src.CurrentClassId,
		UnlockedClasses = unlockedCopy,
		ClassProgress = progressCopy,
		BossKills = {
			PlatformBaron = src.BossKills.PlatformBaron or 0,
			BlackFridayGolem = src.BossKills.BlackFridayGolem or 0,
			NightclubKing = src.BossKills.NightclubKing or 0,
			InflationArchitect = src.BossKills.InflationArchitect or 0,
		},
		Cash = src.Cash,
		TrashTokens = src.TrashTokens,
	}
end

local function sanitizeLoadedProfile(raw: any): PlayerProfile
	local profile = createDefaultProfile()
	if type(raw) ~= "table" then
		return profile
	end

	if type(raw.IsCharacterCreated) == "boolean" then
		profile.IsCharacterCreated = raw.IsCharacterCreated
	end
	if type(raw.RaceId) == "string" then
		profile.RaceId = raw.RaceId
	end
	if type(raw.CurrentClassId) == "string" then
		profile.CurrentClassId = raw.CurrentClassId
	end
	if type(raw.Cash) == "number" then
		profile.Cash = math.max(0, math.floor(raw.Cash))
	end
	if type(raw.TrashTokens) == "number" then
		profile.TrashTokens = math.max(0, math.floor(raw.TrashTokens))
	end

	if type(raw.UnlockedClasses) == "table" then
		for k, v in pairs(raw.UnlockedClasses) do
			if type(k) == "string" and v == true then
				profile.UnlockedClasses[k] = true
			end
		end
	end

	if type(raw.ClassProgress) == "table" then
		for classId, entry in pairs(raw.ClassProgress) do
			if type(classId) == "string" and type(entry) == "table" then
				local lv = math.clamp(math.floor(tonumber(entry.Level) or 1), 1, GameConstants.MAX_LEVEL)
				local exp = math.max(0, math.floor(tonumber(entry.Exp) or 0))
				local hp = math.max(1, math.floor(tonumber(entry.HP) or 180))
				local mp = math.max(0, math.floor(tonumber(entry.MP) or 100))
				profile.ClassProgress[classId] = {
					Level = lv,
					Exp = exp,
					HP = hp,
					MP = mp,
				}
			end
		end
	end

	if type(raw.BossKills) == "table" then
		profile.BossKills.PlatformBaron = math.max(0, math.floor(tonumber(raw.BossKills.PlatformBaron) or 0))
		profile.BossKills.BlackFridayGolem = math.max(0, math.floor(tonumber(raw.BossKills.BlackFridayGolem) or 0))
		profile.BossKills.NightclubKing = math.max(0, math.floor(tonumber(raw.BossKills.NightclubKing) or 0))
		profile.BossKills.InflationArchitect = math.max(0, math.floor(tonumber(raw.BossKills.InflationArchitect) or 0))
	end

	if profile.IsCharacterCreated and not profile.UnlockedClasses[profile.CurrentClassId] then
		profile.UnlockedClasses[profile.CurrentClassId] = true
	end

	return profile
end

local function getPlayerKey(player: Player): string
	return "Player_" .. tostring(player.UserId)
end

function DataManager.LoadProfile(player: Player): PlayerProfile
	if activeProfiles[player] then
		return activeProfiles[player]
	end

	local key = getPlayerKey(player)
	local loadedRaw: any = nil

	local store = getStore()
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key)
		end)
		if ok and result ~= nil then
			loadedRaw = result
		end
	end

	if loadedRaw == nil and memoryFallbackStore[key] ~= nil then
		loadedRaw = deepCopyProfile(memoryFallbackStore[key])
	end

	local profile = sanitizeLoadedProfile(loadedRaw)
	activeProfiles[player] = profile
	memoryFallbackStore[key] = deepCopyProfile(profile)
	return profile
end

function DataManager.GetProfile(player: Player): PlayerProfile
	return activeProfiles[player] or DataManager.LoadProfile(player)
end

function DataManager.SaveProfile(player: Player)
	local profile = activeProfiles[player]
	if not profile then
		return
	end

	local key = getPlayerKey(player)
	local snapshot = deepCopyProfile(profile)
	memoryFallbackStore[key] = snapshot

	local store = getStore()
	if store then
		pcall(function()
			store:SetAsync(key, snapshot)
		end)
	end
end

function DataManager.ResetProfile(player: Player): PlayerProfile
	local fresh = createDefaultProfile()
	activeProfiles[player] = fresh
	DataManager.SaveProfile(player)
	return fresh
end

function DataManager.GetMaxReachedLevel(player: Player): number
	local profile = DataManager.GetProfile(player)
	local maxLv = 1
	for _, entry in pairs(profile.ClassProgress) do
		if entry.Level > maxLv then
			maxLv = entry.Level
		end
	end
	return maxLv
end

function DataManager.GetBossKillCount(player: Player, bossId: string): number
	local profile = DataManager.GetProfile(player)
	local killsTable = profile.BossKills :: any
	return (killsTable[bossId] :: number?) or 0
end

function DataManager.IncrementBossKill(player: Player, bossId: string): number
	local profile = DataManager.GetProfile(player)
	local killsTable = profile.BossKills :: any
	local current = (killsTable[bossId] :: number?) or 0
	local updated = current + 1
	killsTable[bossId] = updated
	return updated
end

function DataManager.AreSubclassRequirementsMet(player: Player): boolean
	local maxLv = DataManager.GetMaxReachedLevel(player)
	if maxLv < GameConstants.SUBCLASS_REQUIRED_LEVEL then
		return false
	end

	for _, bossReq in ipairs(GameConstants.SUBCLASS_REQUIRED_BOSSES) do
		local kills = DataManager.GetBossKillCount(player, bossReq.id)
		if kills < bossReq.requiredKills then
			return false
		end
	end

	return true
end

function DataManager.Init()
	if initialized then
		return
	end
	initialized = true

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			DataManager.LoadProfile(player)
		end)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		DataManager.SaveProfile(player)
		activeProfiles[player] = nil
	end)

	game:BindToClose(function()
		for player, _ in pairs(activeProfiles) do
			DataManager.SaveProfile(player)
		end
	end)
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="17">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = Shared:WaitForChild("configs")
local I18nFolder = Shared:WaitForChild("i18n")

local GameConstants = require(Configs:WaitForChild("GameConstants"))
local MobsConfig = require(Configs:WaitForChild("MobsConfig"))
local I18n = require(I18nFolder:WaitForChild("I18n"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local DataManager = require(script.Parent:WaitForChild("DataManager"))
local MobSpawnerService = require(script.Parent:WaitForChild("MobSpawnerService"))
local CombatService = require(script.Parent:WaitForChild("CombatService"))
local SkillService = require(script.Parent:WaitForChild("SkillService"))

print("=== [MegapolisL2 Server Self-Test] ===")
print(string.format("Remotes initialized inside ReplicatedStorage.%s", Remotes.Folder.Name))

-- 1. Level Penalty self-test for Lv.1 player attacking Lv.1, Lv.5, Lv.6, Lv.8, and Lv.11 mobs
local attackerLevel = 1
local testTargetLevels = { 1, 5, 6, 8, 11 }

print("--- Level Penalty Self-Test (Attacker Lv.1) ---")
for _, targetLevel in ipairs(testTargetLevels) do
	local multiplier = GameConstants.CalculateLevelPenalty(attackerLevel, targetLevel)
	print(
		string.format(
			"Attacker Lv.%d -> Target Lv.%d (diff %+d): Multiplier = %.2f (%.0f%%)",
			attackerLevel,
			targetLevel,
			targetLevel - attackerLevel,
			multiplier,
			multiplier * 100
		)
	)
end

-- 2. Phase 2.5 Exponential MMORPG EXP Curve self-test
print("--- Exponential MMORPG EXP Curve (Lv 1, 10, 20, 30, 40, 50) ---")
for _, lv in ipairs({ 1, 10, 20, 30, 40, 50 }) do
	print(string.format("Lv.%d -> Required EXP = %d", lv, GameConstants.GetRequiredExp(lv)))
end

-- Sort Tier 1 mobs by level for clean console output
local sortedMobs: { MobsConfig.MobData } = {}
for _, mobData in pairs(MobsConfig) do
	table.insert(sortedMobs, mobData)
end
table.sort(sortedMobs, function(a: MobsConfig.MobData, b: MobsConfig.MobData): boolean
	return a.level < b.level
end)

-- 3. List all Tier 1 mobs in both EN and RU
print("--- Tier 1 Mobs (EN / RU) ---")
for _, mob in ipairs(sortedMobs) do
	local nameEn = I18n.t(mob.nameKey, nil, "en")
	local nameRu = I18n.t(mob.nameKey, nil, "ru")
	local lvEn = I18n.t("UI_LEVEL", { lv = mob.level }, "en")
	local lvRu = I18n.t("UI_LEVEL", { lv = mob.level }, "ru")
	local locEn = I18n.t(mob.locationId, nil, "en")
	local locRu = I18n.t(mob.locationId, nil, "en")
	locRu = I18n.t(mob.locationId, nil, "ru")
	local bossTag = if mob.isRaidBoss then " [RAID BOSS]" else ""

	print(
		string.format(
			"[%s]%s | EN: %s (%s) @ %s | RU: %s (%s) @ %s | HP: %d, P.Def: %d, M.Def: %d, ATK: %d",
			mob.id,
			bossTag,
			nameEn,
			lvEn,
			locEn,
			nameRu,
			lvRu,
			locRu,
			mob.maxHp,
			mob.pDef,
			mob.mDef,
			mob.atk
		)
	)
end

-- 4. Initialize Phase 0, 1, 2 & Phase 2.5 Server Services
DataManager.Init()
MobSpawnerService.Init()
CombatService.Init()
SkillService.Init()

print("=== [MegapolisL2 Server Phase 0, Phase 1, Phase 2 & Phase 2.5 Initialized] ===")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MobSpawnerService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = Shared:WaitForChild("configs")
local MobsConfig = require(Configs:WaitForChild("MobsConfig"))

export type ActiveMobState = {
	model: Model,
	mobData: MobsConfig.MobData,
	spawnPoint: BasePart,
	spawnPosition: Vector3,
	currentHp: number,
	maxHp: number,
	isSpoiled: boolean,
	hateList: { [Player]: number },
	lastAttackTime: number,
	stunnedUntil: number,
	pDefDebuffUntil: number,
	pDefMult: number,
	isDead: boolean,
	swept: boolean,
}

type OutfitColors = {
	skin: Color3,
	torso: Color3,
	legs: Color3,
	accent: Color3,
	scale: number,
}

local MOB_OUTFITS: { [string]: OutfitColors } = {
	SleepingCommuter = {
		skin = Color3.fromRGB(235, 200, 175),
		torso = Color3.fromRGB(110, 125, 145),
		legs = Color3.fromRGB(55, 65, 80),
		accent = Color3.fromRGB(180, 180, 195),
		scale = 1.0,
	},
	CanCollector = {
		skin = Color3.fromRGB(220, 185, 155),
		torso = Color3.fromRGB(95, 130, 85),
		legs = Color3.fromRGB(70, 60, 50),
		accent = Color3.fromRGB(190, 150, 70),
		scale = 1.0,
	},
	StationAlchemist = {
		skin = Color3.fromRGB(210, 225, 215),
		torso = Color3.fromRGB(120, 60, 165),
		legs = Color3.fromRGB(45, 35, 60),
		accent = Color3.fromRGB(80, 240, 150),
		scale = 1.05,
	},
	CardboardKnight = {
		skin = Color3.fromRGB(230, 195, 165),
		torso = Color3.fromRGB(185, 140, 85),
		legs = Color3.fromRGB(145, 105, 65),
		accent = Color3.fromRGB(210, 175, 115),
		scale = 1.12,
	},
	TicketInspector = {
		skin = Color3.fromRGB(235, 200, 175),
		torso = Color3.fromRGB(35, 55, 115),
		legs = Color3.fromRGB(25, 35, 65),
		accent = Color3.fromRGB(235, 195, 60),
		scale = 1.08,
	},
	PlatformBaron = {
		skin = Color3.fromRGB(225, 185, 160),
		torso = Color3.fromRGB(145, 25, 35),
		legs = Color3.fromRGB(30, 25, 30),
		accent = Color3.fromRGB(255, 205, 55),
		scale = 1.45,
	},
}

local BOOTSTRAP_MOB_IDS: { string } = {
	"SleepingCommuter",
	"CanCollector",
	"StationAlchemist",
	"CardboardKnight",
	"TicketInspector",
	"PlatformBaron",
}

local LEASH_DISTANCE = 80
local MELEE_ATTACK_RANGE = 6.5
local MELEE_ATTACK_COOLDOWN = 1.8
local AI_TICK_INTERVAL = 0.25

local MobSpawnerService = {}

local activeMobStates: { [Model]: ActiveMobState } = {}
local initialized = false

local function getOrCreateFolder(name: string): Folder
	local existing = Workspace:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = Workspace
	return folder
end

local function createLimb(name: string, size: Vector3, color: Color3, parent: Model): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.Anchored = false
	part.Parent = parent
	return part
end

local function createMotor6D(name: string, part0: BasePart, part1: BasePart, c0: CFrame, c1: CFrame): Motor6D
	local motor = Instance.new("Motor6D")
	motor.Name = name
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = c0
	motor.C1 = c1
	motor.Parent = part0
	return motor
end

function MobSpawnerService.GetMobRoot(mobModel: Model): BasePart?
	if mobModel.PrimaryPart then
		return mobModel.PrimaryPart
	end
	local hrp = mobModel:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	local torso = mobModel:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	return mobModel:FindFirstChildWhichIsA("BasePart")
end

local function buildMobRig(mobData: MobsConfig.MobData, spawnPosition: Vector3): Model
	local outfit: OutfitColors = MOB_OUTFITS[mobData.id]
		or {
			skin = Color3.fromRGB(230, 200, 170),
			torso = Color3.fromRGB(100, 100, 120),
			legs = Color3.fromRGB(50, 50, 65),
			accent = Color3.fromRGB(180, 180, 180),
			scale = 1.0,
		}
	local s = outfit.scale

	local model = Instance.new("Model")
	model.Name = mobData.id

	local rootPart = createLimb("HumanoidRootPart", Vector3.new(2 * s, 2 * s, 1 * s), outfit.torso, model)
	rootPart.Transparency = 1
	rootPart.CanCollide = true

	local torso = createLimb("Torso", Vector3.new(2 * s, 2 * s, 1 * s), outfit.torso, model)
	torso.CanCollide = true

	local head = createLimb("Head", Vector3.new(1.25 * s, 1.25 * s, 1.25 * s), outfit.skin, model)
	local headMesh = Instance.new("SpecialMesh")
	headMesh.MeshType = Enum.MeshType.Head
	headMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	headMesh.Parent = head

	local face = Instance.new("Decal")
	face.Name = "face"
	face.Face = Enum.NormalId.Front
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = head

	local collar = createLimb("AccentCollar", Vector3.new(2.08 * s, 0.35 * s, 1.08 * s), outfit.accent, model)
	local collarWeld = Instance.new("WeldConstraint")
	collarWeld.Part0 = torso
	collarWeld.Part1 = collar
	collarWeld.Parent = collar

	local leftArm = createLimb("Left Arm", Vector3.new(1 * s, 2 * s, 1 * s), outfit.skin, model)
	local rightArm = createLimb("Right Arm", Vector3.new(1 * s, 2 * s, 1 * s), outfit.skin, model)
	local leftLeg = createLimb("Left Leg", Vector3.new(1 * s, 2 * s, 1 * s), outfit.legs, model)
	local rightLeg = createLimb("Right Leg", Vector3.new(1 * s, 2 * s, 1 * s), outfit.legs, model)

	local spawnCFrame = CFrame.new(spawnPosition + Vector3.new(0, 3 * s, 0))
	rootPart.CFrame = spawnCFrame
	torso.CFrame = spawnCFrame
	collar.CFrame = spawnCFrame * CFrame.new(0, 0.75 * s, 0)
	head.CFrame = spawnCFrame * CFrame.new(0, 1.5 * s, 0)
	leftArm.CFrame = spawnCFrame * CFrame.new(-1.5 * s, 0, 0)
	rightArm.CFrame = spawnCFrame * CFrame.new(1.5 * s, 0, 0)
	leftLeg.CFrame = spawnCFrame * CFrame.new(-0.5 * s, -2 * s, 0)
	rightLeg.CFrame = spawnCFrame * CFrame.new(0.5 * s, -2 * s, 0)

	createMotor6D("RootJoint", rootPart, torso, CFrame.new(), CFrame.new())
	createMotor6D("Neck", torso, head, CFrame.new(0, 1 * s, 0), CFrame.new(0, -0.5 * s, 0))
	createMotor6D("LeftShoulder", torso, leftArm, CFrame.new(-1 * s, 0.5 * s, 0), CFrame.new(0.5 * s, 0.5 * s, 0))
	createMotor6D("RightShoulder", torso, rightArm, CFrame.new(1 * s, 0.5 * s, 0), CFrame.new(-0.5 * s, 0.5 * s, 0))
	createMotor6D("LeftHip", torso, leftLeg, CFrame.new(-1 * s, -1 * s, 0), CFrame.new(-0.5 * s, 1 * s, 0))
	createMotor6D("RightHip", torso, rightLeg, CFrame.new(1 * s, -1 * s, 0), CFrame.new(0.5 * s, 1 * s, 0))

	local humanoid = Instance.new("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.MaxHealth = mobData.maxHp
	humanoid.Health = mobData.maxHp
	humanoid.WalkSpeed = if mobData.isRaidBoss then 11 else 13
	humanoid.HipHeight = 0
	humanoid.Parent = model

	model.PrimaryPart = rootPart

	model:SetAttribute("IsMob", true)
	model:SetAttribute("MobId", mobData.id)
	model:SetAttribute("NameKey", mobData.nameKey)
	model:SetAttribute("Level", mobData.level)
	model:SetAttribute("MaxHP", mobData.maxHp)
	model:SetAttribute("CurrentHP", mobData.maxHp)
	model:SetAttribute("BasePDef", mobData.pDef)
	model:SetAttribute("PDef", mobData.pDef)
	model:SetAttribute("MDef", mobData.mDef)
	model:SetAttribute("Atk", mobData.atk)
	model:SetAttribute("IsAggressive", mobData.isAggressive)
	model:SetAttribute("AggroRange", mobData.aggroRange)
	model:SetAttribute("IsSpoiled", false)
	model:SetAttribute("CanSweep", false)
	model:SetAttribute("IsStunned", false)
	model:SetAttribute("SpawnPosition", spawnPosition)

	return model
end

local function playMobAttackSwing(mobModel: Model, targetPosition: Vector3)
	task.spawn(function()
		pcall(function()
			local rootPart = MobSpawnerService.GetMobRoot(mobModel)
			local torso = mobModel:FindFirstChild("Torso") :: BasePart?
			if not rootPart or not torso then
				return
			end

			local outfit = MOB_OUTFITS[mobModel.Name]
			local s = if outfit then outfit.scale else 1.0

			local rightShoulder = torso:FindFirstChild("RightShoulder") :: Motor6D?
				or torso:FindFirstChild("Right Shoulder") :: Motor6D?
			local rootJoint = rootPart:FindFirstChild("RootJoint") :: Motor6D?

			local flatTarget = Vector3.new(targetPosition.X, rootPart.Position.Y, targetPosition.Z)
			local dir = flatTarget - rootPart.Position
			if dir.Magnitude > 0.2 then
				local unitDir = dir.Unit
				local lungePos = rootPart.Position + unitDir * math.min(0.8, dir.Magnitude * 0.2)
				rootPart.CFrame = CFrame.lookAt(lungePos, flatTarget)
			end

			local baseShoulderC0 = CFrame.new(1 * s, 0.5 * s, 0)
			local strikeShoulderC0 = baseShoulderC0 * CFrame.Angles(math.rad(85), math.rad(-20), math.rad(-15))
			local strikeRootC0 = CFrame.Angles(math.rad(-8), math.rad(-16), 0)

			-- Direct C0 assignment without TweenService (since Motor6D.C0 is read-only for TweenService)
			for step = 1, 3 do
				local alpha = step / 3
				if rightShoulder and rightShoulder.Parent then
					rightShoulder.C0 = baseShoulderC0:Lerp(strikeShoulderC0, alpha)
				end
				if rootJoint and rootJoint.Parent then
					rootJoint.C0 = CFrame.new():Lerp(strikeRootC0, alpha)
				end
				task.wait(0.035)
			end

			for step = 1, 4 do
				local alpha = step / 4
				if rightShoulder and rightShoulder.Parent then
					rightShoulder.C0 = strikeShoulderC0:Lerp(baseShoulderC0, alpha)
				end
				if rootJoint and rootJoint.Parent then
					rootJoint.C0 = strikeRootC0:Lerp(CFrame.new(), alpha)
				end
				task.wait(0.04)
			end
		end)
	end)
end

local function bootstrapDefaultSpawns(spawnsFolder: Folder)
	if #spawnsFolder:GetChildren() > 0 then
		return
	end

	local center = Vector3.new(0, 3, -35)
	local radius = 35
	local count = #BOOTSTRAP_MOB_IDS

	for index, mobId in ipairs(BOOTSTRAP_MOB_IDS) do
		local t = if count > 1 then (index - 1) / (count - 1) else 0.5
		local angle = math.pi * t
		local offset = Vector3.new(math.cos(angle) * radius, 0, -math.sin(angle) * radius)

		local spawnPart = Instance.new("Part")
		spawnPart.Name = "Spawn_" .. mobId
		spawnPart.Size = Vector3.new(2, 1, 2)
		spawnPart.Position = center + offset
		spawnPart.Anchored = true
		spawnPart.CanCollide = false
		spawnPart.Transparency = 1
		spawnPart:SetAttribute("MobId", mobId)
		spawnPart.Parent = spawnsFolder
	end
end

local function isPlayerAlive(player: Player): (boolean, Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character or not character.Parent then
		return false, nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not rootPart or humanoid.Health <= 0 then
		return false, nil, nil, nil
	end
	return true, character, humanoid, rootPart
end

local function getTopHatedPlayer(state: ActiveMobState): (Player?, BasePart?, Humanoid?)
	local bestPlayer: Player? = nil
	local bestHate = 0
	local bestRoot: BasePart? = nil
	local bestHum: Humanoid? = nil

	for player, hate in pairs(state.hateList) do
		if player.Parent == Players then
			local alive, _, hum, root = isPlayerAlive(player)
			if alive and hum and root and hate > bestHate then
				bestHate = hate
				bestPlayer = player
				bestRoot = root
				bestHum = hum
			elseif not alive then
				state.hateList[player] = nil
			end
		else
			state.hateList[player] = nil
		end
	end

	return bestPlayer, bestRoot, bestHum
end

function MobSpawnerService.SpawnMobAt(spawnPoint: BasePart): Model?
	local mobIdAttr = spawnPoint:GetAttribute("MobId")
	if type(mobIdAttr) ~= "string" then
		return nil
	end

	local mobData = MobsConfig[mobIdAttr]
	if not mobData then
		warn(string.format("[MobSpawnerService] Unknown MobId '%s' on spawn point %s", mobIdAttr, spawnPoint.Name))
		return nil
	end

	local activeMobsFolder = getOrCreateFolder("ActiveMobs")
	local spawnPos = spawnPoint.Position
	local model = buildMobRig(mobData, spawnPos)
	model.Parent = activeMobsFolder

	local state: ActiveMobState = {
		model = model,
		mobData = mobData,
		spawnPoint = spawnPoint,
		spawnPosition = spawnPos,
		currentHp = mobData.maxHp,
		maxHp = mobData.maxHp,
		isSpoiled = false,
		hateList = {},
		lastAttackTime = 0,
		stunnedUntil = 0,
		pDefDebuffUntil = 0,
		pDefMult = 1.0,
		isDead = false,
		swept = false,
	}

	activeMobStates[model] = state
	return model
end

function MobSpawnerService.GetMobState(mobModel: Model): ActiveMobState?
	return activeMobStates[mobModel]
end

function MobSpawnerService.GetAllActiveMobs(): { [Model]: ActiveMobState }
	return activeMobStates
end

function MobSpawnerService.FindNearestAliveMob(origin: Vector3, maxRange: number): Model?
	local activeMobsFolder = Workspace:FindFirstChild("ActiveMobs")
	if not activeMobsFolder then
		return nil
	end

	local bestMob: Model? = nil
	local bestDist = maxRange

	for _, child in ipairs(activeMobsFolder:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute("IsMob") == true then
			local state = activeMobStates[child]
			local hp = if state then state.currentHp else ((child:GetAttribute("CurrentHP") :: number?) or 0)
			if hp > 0 and (not state or not state.isDead) then
				local root = MobSpawnerService.GetMobRoot(child)
				if root then
					local dist = (root.Position - origin).Magnitude
					if dist <= bestDist then
						bestDist = dist
						bestMob = child
					end
				end
			end
		end
	end

	return bestMob
end

function MobSpawnerService.FindNearestSpoiledCorpse(origin: Vector3, maxRange: number): Model?
	local activeMobsFolder = Workspace:FindFirstChild("ActiveMobs")
	if not activeMobsFolder then
		return nil
	end

	local bestCorpse: Model? = nil
	local bestDist = maxRange

	for _, child in ipairs(activeMobsFolder:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute("IsMob") == true then
			local hp = (child:GetAttribute("CurrentHP") :: number?) or 0
			local isSpoiled = child:GetAttribute("IsSpoiled") == true
			local canSweep = child:GetAttribute("CanSweep") == true
			if hp <= 0 and (isSpoiled or canSweep) then
				local root = MobSpawnerService.GetMobRoot(child)
				if root then
					local dist = (root.Position - origin).Magnitude
					if dist <= bestDist then
						bestDist = dist
						bestCorpse = child
					end
				end
			end
		end
	end

	return bestCorpse
end

function MobSpawnerService.MarkMobSpoiled(mobModel: Model)
	local state = activeMobStates[mobModel]
	if state then
		state.isSpoiled = true
	end
	mobModel:SetAttribute("IsSpoiled", true)
end

function MobSpawnerService.AddHate(mobModel: Model, player: Player, amount: number)
	local state = activeMobStates[mobModel]
	if not state or state.isDead then
		return
	end
	local currentHate = state.hateList[player] or 0
	state.hateList[player] = currentHate + math.max(1, amount)

	local rootPart = MobSpawnerService.GetMobRoot(mobModel)
	if rootPart then
		for otherModel, otherState in pairs(activeMobStates) do
			if otherModel ~= mobModel and not otherState.isDead and otherState.mobData.isSocial then
				local otherRoot = MobSpawnerService.GetMobRoot(otherModel)
				if otherRoot then
					local dist = (otherRoot.Position - rootPart.Position).Magnitude
					if dist <= math.max(12, otherState.mobData.aggroRange) and next(otherState.hateList) == nil then
						otherState.hateList[player] = 1
					end
				end
			end
		end
	end
end

function MobSpawnerService.StunMob(mobModel: Model, duration: number)
	local state = activeMobStates[mobModel]
	if not state or state.isDead then
		return
	end

	local untilTime = os.clock() + duration
	if untilTime > state.stunnedUntil then
		state.stunnedUntil = untilTime
	end
	mobModel:SetAttribute("IsStunned", true)

	local humanoid = mobModel:FindFirstChildOfClass("Humanoid")
	local rootPart = MobSpawnerService.GetMobRoot(mobModel)
	if humanoid and rootPart then
		humanoid:MoveTo(rootPart.Position)
	end
end

function MobSpawnerService.ApplyPDefDebuff(mobModel: Model, mult: number, duration: number)
	local state = activeMobStates[mobModel]
	if not state or state.isDead then
		return
	end
	state.pDefMult = mult
	state.pDefDebuffUntil = os.clock() + duration
	local newPDef = math.max(1, math.floor(state.mobData.pDef * mult + 0.5))
	mobModel:SetAttribute("PDef", newPDef)
end

function MobSpawnerService.KnockbackMob(mobModel: Model, sourcePosition: Vector3, distance: number)
	local state = activeMobStates[mobModel]
	if not state or state.isDead then
		return
	end

	local rootPart = MobSpawnerService.GetMobRoot(mobModel)
	if not rootPart then
		return
	end

	local flatDelta = Vector3.new(rootPart.Position.X - sourcePosition.X, 0, rootPart.Position.Z - sourcePosition.Z)
	local pushDir = if flatDelta.Magnitude > 0.05 then flatDelta.Unit else Vector3.new(0, 0, -1)
	local targetPos = rootPart.Position + pushDir * distance

	local humanoid = mobModel:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:MoveTo(targetPos)
	end

	mobModel:PivotTo(CFrame.lookAt(targetPos, Vector3.new(sourcePosition.X, targetPos.Y, sourcePosition.Z)))
end

function MobSpawnerService.SweepCorpse(mobModel: Model): (boolean, MobsConfig.MobData?)
	if not mobModel or not mobModel.Parent then
		return false, nil
	end

	local state = activeMobStates[mobModel]
	local isSpoiled = (state and state.isSpoiled) or (mobModel:GetAttribute("IsSpoiled") == true)
	local canSweep = mobModel:GetAttribute("CanSweep") == true
	local hp = if state then state.currentHp else ((mobModel:GetAttribute("CurrentHP") :: number?) or 0)

	if hp > 0 or (not isSpoiled and not canSweep) then
		return false, nil
	end
	if state and state.swept then
		return false, nil
	end

	local mobId = (mobModel:GetAttribute("MobId") :: string?) or mobModel.Name
	local mobData = if state then state.mobData else MobsConfig[mobId]
	if not mobData then
		return false, nil
	end

	if state then
		state.swept = true
	end
	mobModel:SetAttribute("CanSweep", false)
	mobModel:SetAttribute("IsSpoiled", false)

	activeMobStates[mobModel] = nil
	mobModel:Destroy()

	return true, mobData
end

function MobSpawnerService.HandleMobDeath(mobModel: Model)
	local state = activeMobStates[mobModel]
	if state and state.isDead then
		return
	end

	local isSpoiled = (state and state.isSpoiled) or (mobModel:GetAttribute("IsSpoiled") == true)
	if state then
		state.isDead = true
		state.currentHp = 0
		table.clear(state.hateList)
	end

	if isSpoiled then
		mobModel:SetAttribute("IsSpoiled", true)
		mobModel:SetAttribute("CanSweep", true)
	end
	mobModel:SetAttribute("CurrentHP", 0)
	mobModel:SetAttribute("IsStunned", false)

	local humanoid = mobModel:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = 0
	end

	local rootPart = MobSpawnerService.GetMobRoot(mobModel)
	if rootPart then
		rootPart.Anchored = true
	end

	local corpseDuration = if isSpoiled then 8.0 else 2.0
	local spawnPoint = if state then state.spawnPoint else nil
	local respawnTime = if state then state.mobData.respawnTime else 10

	task.delay(corpseDuration, function()
		activeMobStates[mobModel] = nil
		if mobModel.Parent then
			mobModel:Destroy()
		end
	end)

	if spawnPoint then
		task.delay(respawnTime, function()
			if spawnPoint and spawnPoint.Parent then
				MobSpawnerService.SpawnMobAt(spawnPoint)
			end
		end)
	end
end

local function stepMobAI(state: ActiveMobState, now: number)
	local model = state.model
	if not model.Parent then
		activeMobStates[model] = nil
		return
	end

	if state.currentHp <= 0 or ((model:GetAttribute("CurrentHP") :: number?) or 0) <= 0 then
		if not state.isDead then
			MobSpawnerService.HandleMobDeath(model)
		end
		return
	end

	if state.pDefDebuffUntil > 0 and now >= state.pDefDebuffUntil then
		state.pDefDebuffUntil = 0
		state.pDefMult = 1.0
		model:SetAttribute("PDef", state.mobData.pDef)
	end

	local rootPart = MobSpawnerService.GetMobRoot(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then
		return
	end

	if now < state.stunnedUntil then
		if model:GetAttribute("IsStunned") ~= true then
			model:SetAttribute("IsStunned", true)
		end
		humanoid:MoveTo(rootPart.Position)
		return
	elseif model:GetAttribute("IsStunned") == true then
		model:SetAttribute("IsStunned", false)
	end

	local distFromSpawn = (rootPart.Position - state.spawnPosition).Magnitude
	if distFromSpawn > LEASH_DISTANCE then
		table.clear(state.hateList)
		state.stunnedUntil = 0
		state.isSpoiled = false
		state.currentHp = state.mobData.maxHp
		model:SetAttribute("IsStunned", false)
		model:SetAttribute("IsSpoiled", false)
		model:SetAttribute("CanSweep", false)
		model:SetAttribute("CurrentHP", state.mobData.maxHp)
		model:SetAttribute("PDef", state.mobData.pDef)
		humanoid.Health = state.mobData.maxHp
		model:PivotTo(CFrame.new(state.spawnPosition + Vector3.new(0, 3.5, 0)))
		humanoid:MoveTo(state.spawnPosition)
		return
	end

	local topPlayer, targetRoot, targetHum = getTopHatedPlayer(state)
	if not topPlayer and state.mobData.isAggressive and state.mobData.aggroRange > 0 then
		local closestDist = state.mobData.aggroRange
		local closestPlayer: Player? = nil

		for _, player in ipairs(Players:GetPlayers()) do
			local alive, _, _, pRoot = isPlayerAlive(player)
			if alive and pRoot then
				local d = (pRoot.Position - rootPart.Position).Magnitude
				if d <= closestDist then
					closestDist = d
					closestPlayer = player
				end
			end
		end

		if closestPlayer then
			state.hateList[closestPlayer] = 10
			topPlayer, targetRoot, targetHum = getTopHatedPlayer(state)
		end
	end

	if topPlayer and targetRoot and targetHum then
		local distToTarget = (targetRoot.Position - rootPart.Position).Magnitude
		if distToTarget > MELEE_ATTACK_RANGE - 1.2 then
			humanoid:MoveTo(targetRoot.Position)
		else
			humanoid:MoveTo(rootPart.Position)
		end

		if distToTarget <= MELEE_ATTACK_RANGE and (now - state.lastAttackTime) >= MELEE_ATTACK_COOLDOWN then
			state.lastAttackTime = now

			local playerPDef = (topPlayer:GetAttribute("PDef") :: number?) or 25
			local effectiveDamage = math.max(1, math.floor(state.mobData.atk * (100 / (100 + playerPDef)) + 0.5))
			targetHum:TakeDamage(effectiveDamage)

			playMobAttackSwing(model, targetRoot.Position)
		end
	end
end

function MobSpawnerService.Init()
	if initialized then
		return
	end
	initialized = true

	local spawnsFolder = getOrCreateFolder("MobSpawns")
	getOrCreateFolder("ActiveMobs")

	bootstrapDefaultSpawns(spawnsFolder)

	for _, child in ipairs(spawnsFolder:GetChildren()) do
		if child:IsA("BasePart") then
			MobSpawnerService.SpawnMobAt(child)
		end
	end

	task.spawn(function()
		while true do
			task.wait(AI_TICK_INTERVAL)
			local now = os.clock()
			for _, state in pairs(activeMobStates) do
				if not state.isDead then
					stepMobAI(state, now)
				end
			end
		end
	end)
end

return MobSpawnerService
]]></string>
        </Properties>
      </Item>
