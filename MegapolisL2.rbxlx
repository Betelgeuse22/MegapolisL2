            <string name="Name">SkillsConfig</string>
            <string name="Source"><![CDATA[--!strict

export type SkillSlot = "Q" | "E" | "R" | "F"

export type SkillTargetType = "SingleTarget" | "DeadSpoiledTarget" | "SelfAoE" | "FrontalCone" | "SelfBuff"

export type SkillData = {
	id: string,
	classId: string,
	slot: SkillSlot,
	nameKey: string,
	descKey: string,
	cooldown: number,
	range: number,
	mpCost: number,
	targetType: SkillTargetType,
	damageMult: number?,
	hitCount: number?,
	stunDuration: number?,
	aggroBonus: number?,
	knockbackDist: number?,
	coneAngleDeg: number?,
	bleedDuration: number?,
	bleedTickMult: number?,
	pDefDebuffMult: number?,
	pDefDebuffDuration: number?,
	buffDuration: number?,
	buffPDefMult: number?,
	buffWalkSpeedMult: number?,
	buffAtkSpdMult: number?,
	buffCritBonus: number?,
	buffCashMult: number?,
}

local SkillsConfig: { [string]: SkillData } = {
